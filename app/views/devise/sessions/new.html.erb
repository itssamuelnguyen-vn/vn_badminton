<% content_for :title, t(".title") %>

<div class="card mx-auto max-w-md">
  <h1 class="mb-6 text-2xl font-bold"><%= t(".title") %></h1>

  <%= form_with model: resource, scope: resource_name, url: session_path(resource_name), class: "space-y-5" do |f| %>
    <div>
      <%= f.label :login, t(".login"), class: "form-label" %>
      <%= f.text_field :login, autofocus: true, required: true, autocomplete: "username", class: "form-input" %>
      <p class="form-hint"><%= t(".login_hint") %></p>
    </div>

    <div>
      <%= f.label :password, class: "form-label" %>
      <%= f.password_field :password, required: true, autocomplete: "current-password", class: "form-input" %>
    </div>

    <div class="flex items-center justify-between">
      <label class="flex items-center gap-2 text-sm text-slate-700">
        <%= f.check_box :remember_me, class: "size-4 rounded border-slate-300 accent-emerald-600" %>
        <%= t(".remember_me") %>
      </label>
      <%= link_to t(".forgot_password"), new_password_path(resource_name), class: "link text-sm" %>
    </div>

    <%= f.submit t(".submit"), class: "btn-primary w-full" %>
  <% end %>

  <p class="mt-6 text-center text-sm text-slate-600">
    <%= t(".no_account") %> <%= link_to t(".sign_up"), new_registration_path(resource_name), class: "link" %>
  </p>
</div>
