- content_for :title, t("devise.sessions.new.title")

= render layout: "devise/shared/auth_shell" do
    h1 class="text-2xl font-bold sm:text-3xl" = t("devise.sessions.new.title")
    p class="mt-1 mb-8 text-sm text-slate-500" = t("devise.sessions.new.subtitle")

    = render "devise/shared/google"

    = form_with model: resource, scope: resource_name, url: session_path(resource_name), class: "space-y-5" do |f|
      div
        = f.label :login, t("devise.sessions.new.login"), class: "form-label"
        = f.text_field :login, autofocus: true, required: true, autocomplete: "username", class: "form-input"
        p.form-hint = t("devise.sessions.new.login_hint")

      div
        = f.label :password, class: "form-label"
        = f.password_field :password, required: true, autocomplete: "current-password", class: "form-input"

      / No "remember me": everyone signs in again after 30 minutes without activity (Devise :timeoutable).
      div class="flex justify-end"
        = link_to t("devise.sessions.new.forgot_password"), new_password_path(resource_name), class: "link text-sm"

      = f.submit t("devise.sessions.new.submit"), class: "btn-primary w-full"

    p class="mt-6 text-center text-sm text-slate-600"
      => t("devise.sessions.new.no_account")
      = link_to t("devise.sessions.new.sign_up"), new_registration_path(resource_name), class: "link"
