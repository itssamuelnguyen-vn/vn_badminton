/ Sign-in and sign-up: the form next to a brand panel with what an account brings (desktop only).
div class="surface mx-auto grid max-w-4xl overflow-hidden md:grid-cols-[1fr_1.15fr]"
  div class="brand-gradient relative hidden flex-col justify-between gap-10 overflow-hidden p-10 text-white md:flex"
    div class="pointer-events-none absolute -top-24 -right-20 size-72 rounded-full bg-white/10" aria-hidden="true"
    div class="pointer-events-none absolute -bottom-24 -left-10 size-72 rounded-full bg-lime-300/25 blur-3xl" aria-hidden="true"
    div class="relative"
      span class="flex size-14 items-center justify-center rounded-2xl bg-white/15 ring-1 ring-white/25"
        = image_tag "logo-mark.png", alt: "", class: "h-10 w-auto", width: 78, height: 96
      p class="mt-6 text-3xl leading-tight font-bold text-balance" = t("devise.shared.auth_shell.headline")
    ul class="relative space-y-3 text-sm font-medium"
      - t("devise.shared.auth_shell.benefits").each do |benefit|
        li class="flex items-start gap-3"
          span class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-lime-300 text-emerald-900" aria-hidden="true"
            svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"
              path d="M5 12.5l4.5 4.5L19 7.5"
          span = benefit
  div class="p-6 sm:p-10"
    = yield
