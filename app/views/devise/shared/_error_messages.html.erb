<% if resource.errors.any? %>
  <div id="error_explanation" role="alert" class="mb-6 rounded-lg bg-red-50 px-4 py-3 text-sm text-red-800 ring-1 ring-red-200">
    <p class="font-semibold">
      <%= t(".title", count: resource.errors.count) %>
    </p>
    <ul class="mt-2 list-disc space-y-1 pl-5">
      <% resource.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
