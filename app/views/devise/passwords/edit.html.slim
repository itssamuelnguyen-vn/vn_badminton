- content_for :title, t(".title")

div class="card mx-auto max-w-md"
  h1 class="mb-6 text-2xl font-bold" = t(".title")

  = form_with model: resource, scope: resource_name, url: password_path(resource_name), method: :put, class: "space-y-5" do |f|
    = render "devise/shared/error_messages", resource: resource
    = f.hidden_field :reset_password_token

    div
      = f.label :password, t(".new_password"), class: "form-label"
      = f.password_field :password, autofocus: true, required: true, minlength: @minimum_password_length, autocomplete: "new-password", class: "form-input"
      - if @minimum_password_length
        p.form-hint = t("devise.registrations.new.password_hint", count: @minimum_password_length)

    div
      = f.label :password_confirmation, class: "form-label"
      = f.password_field :password_confirmation, required: true, autocomplete: "new-password", class: "form-input"

    = f.submit t(".submit"), class: "btn-primary w-full"
