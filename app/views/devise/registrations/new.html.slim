- content_for :title, t(".title")

div class="card mx-auto max-w-md"
  h1 class="mb-6 text-2xl font-bold" = t(".title")

  = form_with model: resource, scope: resource_name, url: registration_path(resource_name), class: "space-y-5" do |f|
    = render "devise/shared/error_messages", resource: resource
    / Later emails (reminders, ...) are sent in the language used to sign up.
    = f.hidden_field :locale, value: I18n.locale

    div
      = f.label :full_name, class: "form-label"
      = f.text_field :full_name, autofocus: true, required: true, maxlength: 100, autocomplete: "name", class: "form-input"

    div
      = f.label :phone, class: "form-label"
      = f.telephone_field :phone, required: true, autocomplete: "tel", placeholder: "0901 234 567", class: "form-input"

    div
      = f.label :email, class: "form-label"
      = f.email_field :email, required: true, autocomplete: "email", class: "form-input"

    div
      = f.label :password, class: "form-label"
      = f.password_field :password, required: true, minlength: @minimum_password_length, autocomplete: "new-password", class: "form-input"
      p.form-hint = t(".password_hint", count: @minimum_password_length)

    div
      = f.label :password_confirmation, class: "form-label"
      = f.password_field :password_confirmation, required: true, autocomplete: "new-password", class: "form-input"

    label class="flex items-start gap-2 text-sm text-slate-700"
      = f.check_box :privacy_consent, required: true, class: "mt-0.5 size-4 shrink-0 accent-emerald-600"
      span = t(".privacy_consent_html", link: link_to(t(".privacy_policy"), privacy_path, class: "link", target: "_blank"))

    = f.submit t(".submit"), class: "btn-primary w-full"

  p class="mt-6 text-center text-sm text-slate-600"
    => t(".have_account")
    = link_to t(".sign_in"), new_session_path(resource_name), class: "link"
