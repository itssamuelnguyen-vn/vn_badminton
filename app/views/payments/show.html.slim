- content_for :title, t(".title")
- content_for :head do
  meta name="robots" content="noindex"
/ Refreshes itself when the transfer arrives or the time runs out (Payment#stream).
- turbo_refreshes_with method: :morph, scroll: :preserve
= turbo_stream_from @payment.stream
- payment = @payment

div class="card mx-auto max-w-lg"
  - if payment.paid?
    div class="text-center" role="status"
      span class="brand-gradient mx-auto flex size-16 items-center justify-center rounded-full text-white shadow-lg shadow-emerald-700/30" aria-hidden="true"
        svg class="size-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"
          path d="M5 12.5l4.5 4.5L19 7.5"
      h1 class="mt-4 text-2xl font-bold text-emerald-700" = t(".paid_title")
      p class="mt-2 text-sm text-slate-600" = t({ "bookings" => ".paid_bookings", "tickets" => ".paid_tickets", "package" => ".paid_package",
                                                   "tournament" => ".paid_tournament" }.fetch(payment.purpose, ".paid_series"))
      - if payment.for_bookings? && user_signed_in? && @bookings.first&.user == current_user
        = link_to t(".view_bookings"), (@bookings.one? ? booking_path(@bookings.first) : bookings_path), class: "btn-primary mt-6"
      - elsif payment.for_package? && user_signed_in? && payment.user == current_user
        = link_to t(".view_packages"), packages_path, class: "btn-primary mt-6"
      - elsif payment.for_tournament? && payment.tournament_entry
        = link_to t(".view_tournament"), tournament_path(payment.tournament_entry.tournament_id), class: "btn-primary mt-6"
      - elsif user_signed_in? && payment.user_id == current_user.id && (payment.for_tickets? || payment.for_series_period?)
        = link_to t(payment.for_tickets? ? ".view_play_sessions" : ".view_series"), (payment.for_tickets? ? play_sessions_path : series_index_path), class: "btn-primary mt-6"
  - elsif !payment.open?
    div class="text-center" role="status"
      h1 class="text-2xl font-bold" = t(payment.cancelled? ? ".cancelled_title" : ".closed_title")
      p class="mt-2 text-sm text-slate-600" = t(payment.cancelled? ? ".cancelled_text" : ".closed_text")
      = link_to t(".book_again"), root_path, class: "btn-primary mt-6"
  - else
    - received = payment.received_vnd
    - remaining = payment.amount_vnd - received
    h1 class="mb-1 text-2xl font-bold" = t(".title")
    p class="mb-4 text-sm text-slate-600" = t(".intro")
    - if received.positive?
      p class="mb-4 rounded-2xl bg-amber-50 px-4 py-3 text-sm font-medium text-amber-900 ring-1 ring-amber-200" role="status"
        = t(".underpaid", received: format_vnd(received), remaining: format_vnd(remaining), code: payment.code)

    - if payment.expires_at
      = tag.div class: "mb-4 rounded-2xl bg-violet-50 px-4 py-3 text-sm text-violet-900 ring-1 ring-violet-200", role: "timer", aria: { live: "off" },
          data: { controller: "hold-countdown", hold_countdown_seconds_value: [ (payment.expires_at - Time.current).ceil, 0 ].max } do
        p data-hold-countdown-target="running"
          = t(".deadline_html", time: tag.strong("--:--", class: "tabular-nums", data: { hold_countdown_target: "clock" }))
        p hidden=true data-hold-countdown-target="expired" = t(".deadline_passed")

    / The QR code in a brand-coloured frame.
    div class="flex justify-center"
      div class="brand-gradient rounded-[1.75rem] p-1.5 shadow-xl shadow-emerald-700/20"
        = image_tag payment.qr_url(@venue, remaining), alt: t(".qr_alt"), class: "w-64 max-w-full rounded-3xl bg-white p-2", width: 256, height: 256
    div class="mt-3 flex flex-col items-center gap-1 text-center" data-controller="qr-save" data-qr-save-filename-value="QR-#{payment.code}.png"
      = link_to t(".save_qr"), qr_payment_path(payment), download: "QR-#{payment.code}.png", class: "btn-secondary",
          data: { qr_save_target: "link", action: "qr-save#save", turbo: false }
      p class="text-xs text-slate-500" = t(".save_qr_hint")

    dl class="mt-4 divide-y divide-slate-100 text-sm"
      - [ [ t(".bank"), @venue.bank_code ], [ t(".account_number"), @venue.bank_account_number ], [ t(".account_name"), @venue.bank_account_name ],
          [ t(".amount"), format_vnd(remaining) ], [ t(".content"), payment.code ] ].each do |label, value|
        - next if value.blank?
        div class="flex justify-between gap-4 py-2"
          dt class="text-slate-500" = label
          dd class="font-semibold tabular-nums select-all" = value

    p class="mt-4 rounded-2xl bg-amber-50 px-4 py-3 text-sm text-amber-800 ring-1 ring-amber-200" = t(".exact", amount: format_vnd(remaining), code: payment.code)

    / Giving up before transferring releases the courts or places at once (Payment#cancel_by!).
    - if payment.cancellable_by?(current_user)
      div class="mt-4 text-center"
        = button_to t({ "tickets" => ".cancel_tickets", "tournament" => ".cancel_tournament" }.fetch(payment.purpose, ".cancel_bookings")), cancel_payment_path(payment), method: :patch,
            class: "btn w-full bg-white text-red-600 ring-1 ring-red-200 hover:bg-red-50", form: { data: { turbo_confirm: t(".cancel_confirm") } }
        p class="mt-1 text-xs text-slate-500" = t(".cancel_hint")

  - if @bookings.any?
    div class="mt-6 border-t border-slate-100 pt-4"
      p class="mb-2 text-sm font-medium" = t(".for")
      ul class="space-y-1 text-sm text-slate-600"
        - @bookings.each do |booking|
          li = "#{booking.court.display_name} · #{l(booking.starts_at.to_date, format: :full)} · #{time_range(booking.starts_at, booking.ends_at)}"
  - elsif payment.for_tickets? && (ticket = payment.play_session_ticket)
    p class="mt-6 border-t border-slate-100 pt-4 text-sm text-slate-600"
      = t(".for_tickets", title: ticket.play_session.display_title, count: ticket.quantity,
          time: "#{l(ticket.play_session.starts_at.to_date, format: :full)} · #{time_range(ticket.play_session.starts_at, ticket.play_session.ends_at)}")
  - elsif payment.for_tournament? && (entry = payment.tournament_entry)
    p class="mt-6 border-t border-slate-100 pt-4 text-sm text-slate-600"
      = t(".for_tournament", title: entry.tournament.display_title, name: entry.display_name)
  - elsif payment.for_package? && payment.package_purchase
    p class="mt-6 border-t border-slate-100 pt-4 text-sm text-slate-600"
      = t(".for_package", name: payment.package_purchase.display_name)
  - elsif payment.for_series_period?
    p class="mt-6 border-t border-slate-100 pt-4 text-sm text-slate-600"
      = t(".for_series", month: l(payment.series_month, format: :month_year), name: payment.series.customer_name)
