<section class="mx-auto max-w-2xl py-8 text-center sm:py-16">
  <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-5xl"><%= t(".title") %></h1>
  <p class="mt-4 text-lg text-slate-600"><%= t(".subtitle") %></p>

  <div class="mt-8 flex flex-wrap justify-center gap-3">
    <% if user_signed_in? %>
      <p class="text-slate-700"><%= t(".welcome_back", name: current_user.full_name) %></p>
    <% else %>
      <%= link_to t(".sign_up"), new_user_registration_path, class: "btn-primary px-6 py-3 text-base" %>
      <%= link_to t(".sign_in"), new_user_session_path, class: "btn-secondary px-6 py-3 text-base" %>
    <% end %>
  </div>
</section>
