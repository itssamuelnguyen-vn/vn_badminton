- locale = (I18n.locale unless I18n.locale == I18n.default_locale)

table cellpadding="4" style="margin-bottom: 16px"
  tr
    td = Booking.human_attribute_name(:code)
    td
      strong = link_to booking.code, booking_url(booking, locale: locale)
  tr
    td = Booking.human_attribute_name(:court)
    td = booking.court.display_name
  tr
    td = t("bookings.details.date")
    td = l(booking.starts_at.to_date, format: :full)
  tr
    td = t("bookings.details.time")
    td = time_range(booking.starts_at, booking.ends_at)
  tr
    td = t("bookings.details.price")
    td = format_vnd(booking.charged_vnd)
