- locale = (I18n.locale unless I18n.locale == I18n.default_locale)

p = t(".greeting", name: @bookings.first.customer_name)

p = t(".intro", count: @bookings.size)

= render partial: "booking_mailer/booking", collection: @bookings

p
  => t("bookings.details.total")
  strong = format_vnd(@bookings.sum(&:charged_vnd))

p = @bookings.all?(&:payment_paid?) ? t(".paid") : t("bookings.new.pay_at_venue")

p = link_to t(".view_bookings"), bookings_url(locale: locale)

p = t(".cancel_policy", hours: @bookings.first.court.venue.cancellation_cutoff_hours)
