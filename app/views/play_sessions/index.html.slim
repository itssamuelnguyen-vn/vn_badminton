- content_for :title, t(".title")
- now = Time.current

div class="mx-auto max-w-2xl"
  div class="mb-8"
    h1 class="text-2xl font-bold sm:text-3xl" = t(".title")
    p class="mt-2 text-sm text-slate-600" = t(".intro")

  - if @sessions.empty?
    div class="card flex flex-col items-center gap-3 text-center"
      span class="flex size-14 items-center justify-center rounded-2xl bg-emerald-50 text-emerald-600" aria-hidden="true"
        svg class="size-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
          circle cx="9" cy="8" r="3.5"
          path d="M2.5 20a6.5 6.5 0 0 1 13 0M16 4.5a3.5 3.5 0 0 1 0 7M18 14.5a6.5 6.5 0 0 1 3.5 5.5"
      p class="text-sm text-slate-600" = t(".none")
  - else
    div class="space-y-4"
      - @sessions.each do |play_session|
        = render "play_sessions/session", play_session: play_session, courts: play_session.court_ids.filter_map { |id| @courts[id] }.sort_by { |court| [ court.position, court.id ] },
            tickets: @mine.fetch(play_session.id, []), now: now
