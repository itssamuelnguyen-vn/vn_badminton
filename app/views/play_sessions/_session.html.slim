/ One open play session: a date tile, title, time, courts and price; places left; the customer's own places
/ (pay, give up) and the form to buy more.
- date = play_session.starts_at.to_date
- seats_left = play_session.seats_left(now)
article id=dom_id(play_session) class="surface p-4 sm:p-5"
  div class="flex items-start gap-4"
    div class="brand-gradient flex w-16 shrink-0 flex-col items-center rounded-2xl py-2 leading-none text-white shadow-md shadow-emerald-700/25"
      span class="text-[11px] font-semibold uppercase opacity-80" = t("schedules.date_picker.weekdays")[date.cwday - 1]
      span class="my-1 text-2xl font-bold tabular-nums" = date.day
      span class="text-[11px] font-medium opacity-80 tabular-nums" = l(date, format: "%m/%Y")
    div class="min-w-0 flex-1"
      h2 class="font-bold text-balance" = play_session.display_title
      p class="mt-0.5 text-sm text-slate-600 tabular-nums" = "#{time_range(play_session.starts_at, play_session.ends_at)} · #{courts.map(&:display_name).join(", ")}"
      div class="mt-2 flex flex-wrap gap-1.5 text-xs font-semibold"
        span class="rounded-full bg-emerald-50 px-2.5 py-0.5 text-emerald-700 ring-1 ring-emerald-200" = t(".price", price: format_vnd(play_session.price_vnd))
        span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-slate-700" = t("play_sessions.levels.#{play_session.level || "any"}")
        - if seats_left.positive?
          span class="rounded-full bg-sky-50 px-2.5 py-0.5 text-sky-700 ring-1 ring-sky-200" = t(".seats_left", count: seats_left, capacity: play_session.capacity)
        - else
          span class="rounded-full bg-red-50 px-2.5 py-0.5 text-red-700 ring-1 ring-red-200" = t(".full")

  - if play_session.description.present?
    p class="mt-3 text-sm whitespace-pre-line text-slate-600" = play_session.description

  - tickets.each do |ticket|
    div class="mt-3 flex flex-wrap items-center justify-between gap-2 rounded-2xl px-4 py-3 text-sm ring-1 #{ticket.confirmed? ? "bg-emerald-50 text-emerald-900 ring-emerald-200" : "bg-violet-50 text-violet-900 ring-violet-200"}"
      p
        = t(".mine.#{ticket.confirmed? ? "confirmed" : "pending"}", count: ticket.quantity, amount: format_vnd(ticket.amount_vnd))
      div class="flex flex-wrap gap-2"
        - if ticket.pending? && ticket.payment&.open?(now)
          = link_to t("bookings.index.pay_now"), payment_path(ticket.payment), class: "btn-primary px-3 py-1.5 text-xs"
        - if ticket.cancellable_by_customer?(now)
          = button_to t(".give_up"), play_session_ticket_path(ticket), method: :delete, class: "btn-secondary px-3 py-1.5 text-xs",
              form: { data: { turbo_confirm: (ticket.confirmed? ? t(".give_up_confirm_paid") : t(".give_up_confirm")) } }

  - if play_session.bookable?(now) && seats_left.positive?
    div class="mt-4 border-t border-slate-100 pt-4"
      - if user_signed_in?
        = form_with url: buy_play_session_path(play_session), class: "flex flex-wrap items-end gap-3" do |f|
          div
            = f.label :quantity, t(".quantity"), for: "quantity_#{play_session.id}", class: "form-label"
            = f.select :quantity, (1..[ PlaySessionTicket::MAX_QUANTITY, seats_left ].min).map { |n| [ n, n ] }, {}, id: "quantity_#{play_session.id}", class: "form-input w-24"
          = f.submit t(".buy"), class: "btn-primary flex-1 sm:flex-none"
        p class="form-hint" = t(".buy_hint", count: Payment::WINDOW.in_minutes.to_i)
      - else
        = link_to t(".sign_in_to_buy"), new_user_session_path, class: "btn-primary w-full sm:w-auto"
