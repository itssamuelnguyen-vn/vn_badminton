/ The creator's helpers (GD-02): the link to send them (signed in, they accept it and can enter results), who
/ joined (remove one), and a new link when the old one went to the wrong people.
- link = organize_tournament_url(tournament, organizer_token: tournament.organizer_token)
section id="organizers" class="card space-y-3"
  div
    h2 class="section-title" = t(".title")
    p class="mt-1 text-sm text-slate-600" = t(".hint")
  div class="flex flex-wrap gap-2" data-controller="share-link" data-share-link-url-value=link data-share-link-title-value=tournament.title data-share-link-copied-value=t("tournaments.show.copied")
    button type="button" class="btn-primary px-3 py-1.5 text-xs" data-share-link-target="button" data-action="share-link#share" = t(".send_link")
    = button_to t(".reset_link"), organizer_link_tournament_path(tournament), method: :patch, class: "btn-secondary px-3 py-1.5 text-xs",
        form: { data: { turbo_confirm: t(".reset_confirm") } }
  - if @organizers.any?
    ul class="divide-y divide-slate-100 rounded-2xl text-sm ring-1 ring-slate-200"
      - @organizers.each do |organizer|
        li class="flex items-center justify-between gap-3 px-3 py-2"
          span class="font-medium" = organizer.user.full_name
          = button_to t(".remove"), organizers_tournament_path(tournament, user_id: organizer.user_id), method: :delete,
              class: "text-xs font-semibold text-red-600 hover:underline", form: { data: { turbo_confirm: t(".remove_confirm", name: organizer.user.full_name) } }
  - else
    p class="text-sm text-slate-500" = t(".none")
