/ The creator's form (new and edit). The event and the format only change before the draw, the event only while
/ no player is typed (RunsTournaments#tournament_params).
= form_with model: tournament, class: "space-y-5" do |f|
  = render "devise/shared/error_messages", resource: tournament
  div
    = f.label :title, class: "form-label"
    = f.text_field :title, maxlength: 100, required: true, placeholder: t("tournaments.form.title_placeholder"), class: "form-input"
  div
    = f.label :description, class: "form-label"
    = f.text_area :description, maxlength: 2000, rows: 3, placeholder: t("tournaments.form.description_placeholder"), class: "form-input"
  div class="grid gap-3 sm:grid-cols-2"
    div
      = f.label :discipline, class: "form-label"
      = f.select :discipline, Tournament::DISCIPLINES.map { |discipline| [ t("tournaments.events.#{discipline}"), discipline ] }, {},
          class: "form-input", disabled: tournament.persisted? && tournament.entries.any?
      - if tournament.persisted? && tournament.entries.any?
        p class="form-hint" = t("tournaments.form.discipline_locked")
    div
      = f.label :played_on, class: "form-label"
      = f.date_field :played_on, class: "form-input"
      p class="form-hint" = t("tournaments.form.played_on_hint")
  - if tournament.new_record? || tournament.setup?
    fieldset
      legend class="form-label" = Tournament.human_attribute_name(:play_format)
      div class="grid gap-2 sm:grid-cols-3"
        - Tournament::FORMATS.each do |format|
          label class="flex cursor-pointer flex-col gap-1 rounded-xl p-3 text-sm ring-1 ring-slate-300 has-checked:bg-emerald-50 has-checked:ring-emerald-500"
            span class="flex items-center gap-2 font-semibold"
              = f.radio_button :play_format, format, class: "accent-emerald-600"
              = t("tournaments.formats.#{format}")
            span class="text-xs text-slate-600" = t("tournaments.form.format_hints.#{format}", count: Tournament::ROUND_ROBIN_MAX)
    div class="grid grid-cols-2 gap-3"
      div
        = f.label :group_size, class: "form-label"
        = f.number_field :group_size, min: 3, max: 6, class: "form-input"
      div
        = f.label :advance_per_group, class: "form-label"
        = f.select :advance_per_group, [ 1, 2 ], {}, class: "form-input"
      p class="form-hint col-span-2 -mt-1" = t("tournaments.form.groups_hint")
  div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end"
    = link_to t("tournaments.form.back"), (tournament.persisted? ? tournament_path(tournament) : tournaments_path), class: "btn-secondary"
    = f.submit (tournament.persisted? ? t("tournaments.form.save") : t("tournaments.form.create")), class: "btn-primary"
