/ One match on the organizers' desk: both sides, its court once called; call it to a court of the tournament's
/ bookings; enter or correct the result (up to 3 games from side a's view, or a walkover).
div id=dom_id(match) class="space-y-3 px-4 py-3 text-sm sm:px-5"
  div class="flex flex-wrap items-center justify-between gap-3"
    div class="min-w-0"
      p class="text-xs text-slate-500"
        = match.group? ? "#{t("tournaments.standings.group", name: (64 + match.group_number).chr)} · #{match.round_name}" : match.round_name
      p class="break-words"
        span class=("font-semibold text-emerald-800" if match.winner_id && match.winner_id == match.entry_a_id) = match.entry_a.display_name
        span class="text-slate-400" =< t(".versus")
        span class=("font-semibold text-emerald-800" if match.winner_id && match.winner_id == match.entry_b_id) =< match.entry_b.display_name
    p class="text-xs text-slate-500 tabular-nums"
      - if match.finished?
        = match.walkover ? t("tournaments.walkover") : match.score_text
      - elsif match.court
        span class="rounded-full bg-orange-50 px-2 py-0.5 font-semibold text-orange-800" = t("tournaments.on_court", court: match.court.display_name)
  - if match.ready? && courts.any?
    = form_with url: call_tournament_match_path(tournament, match), method: :patch, class: "flex flex-wrap items-center gap-2" do |f|
      = f.select :court_id, courts.map { |court| [ court.display_name, court.id ] }, { selected: match.court_id, include_blank: t(".no_court") },
          class: "form-input w-auto py-1.5 text-xs", aria: { label: t(".court") }
      = f.submit t(".set_court"), class: "btn-secondary px-3 py-1.5 text-xs"
  - if match.editable?
    details open=(match.ready? && match.called_at.present?)
      summary class="cursor-pointer text-xs font-semibold text-emerald-700" = match.finished? ? t(".correct") : t(".enter_result")
      = form_with url: tournament_match_path(tournament, match), method: :patch, class: "mt-3 space-y-3" do |f|
        div class="flex flex-wrap gap-3"
          - 3.times do |index|
            - game = match.scores[index] || []
            fieldset class="flex items-center gap-1"
              legend class="sr-only" = t(".game", number: index + 1)
              span class="mr-1 text-xs text-slate-500" = t(".game", number: index + 1)
              = number_field_tag "scores[#{index}][a]", game[0], min: 0, max: 99, inputmode: "numeric", class: "form-input w-14 px-2 py-1 text-center", aria: { label: match.entry_a.display_name }
              span -
              = number_field_tag "scores[#{index}][b]", game[1], min: 0, max: 99, inputmode: "numeric", class: "form-input w-14 px-2 py-1 text-center", aria: { label: match.entry_b.display_name }
        div class="flex flex-wrap items-center gap-2"
          = f.submit t(".save_result"), class: "btn-primary px-3 py-1.5 text-xs"
          span class="text-xs text-slate-500" = t(".or_walkover")
          - [ [ "a", match.entry_a ], [ "b", match.entry_b ] ].each do |side, entry|
            = f.button t(".walkover_for", name: entry.display_name), name: "walkover", value: side, class: "btn-secondary px-3 py-1.5 text-xs",
                data: { turbo_confirm: t(".walkover_confirm", name: entry.display_name) }
