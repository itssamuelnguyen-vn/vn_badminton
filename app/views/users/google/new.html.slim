- content_for :title, t("users.google.new.title")

/ The end of a Google sign-in for someone new: Google gave the name and a verified email; a phone number and the
/ consent are still needed, as on the sign-up page.
= render layout: "devise/shared/auth_shell" do
    h1 class="text-2xl font-bold sm:text-3xl" = t("users.google.new.title")
    p class="mt-1 mb-8 text-sm text-slate-500" = t("users.google.new.subtitle", email: @identity.email)

    = form_with model: @user, scope: :user, url: register_google_sign_in_path, class: "space-y-5" do |f|
      = render "devise/shared/error_messages", resource: @user

      div
        = f.label :full_name, class: "form-label"
        = f.text_field :full_name, required: true, maxlength: 100, autocomplete: "name", class: "form-input"

      div
        = f.label :phone, class: "form-label"
        = f.telephone_field :phone, autofocus: true, required: true, autocomplete: "tel", placeholder: "0901 234 567", class: "form-input"

      label class="flex items-start gap-2 text-sm text-slate-700"
        = f.check_box :privacy_consent, required: true, class: "mt-0.5 size-4 shrink-0 accent-emerald-600"
        span = t("devise.registrations.new.privacy_consent_html", link: link_to(t("devise.registrations.new.privacy_policy"), privacy_path, class: "link", target: "_blank"))

      = f.submit t("users.google.new.submit"), class: "btn-primary w-full"
