- content_for :title, t(".title")
- bookings = @batch.bookings
- several = bookings.size > 1

div class="card mx-auto max-w-lg"
  h1 class="mb-6 text-2xl font-bold" = t(".title")

  = form_with scope: :booking, url: bookings_path, class: "space-y-6" do |f|
    - if @batch.errors?
      div#error_explanation role="alert" class="rounded-lg bg-red-50 px-4 py-3 text-sm text-red-800 ring-1 ring-red-200"
        ul class="list-disc space-y-1 pl-5"
          - bookings.each do |booking|
            - booking.errors.full_messages.each do |message|
              li = several ? "#{booking.court.display_name}: #{message}" : message

    - bookings.each_with_index do |booking, index|
      div class=("rounded-lg ring-1 ring-slate-200 px-4" if several)
        = render "bookings/details", booking: booking, total_label: (t("bookings.details.price") if several)
      = hidden_field_tag "booking[slots][#{index}][court_id]", booking.court_id
      = hidden_field_tag "booking[slots][#{index}][starts_at]", booking.starts_at&.iso8601
      = hidden_field_tag "booking[slots][#{index}][ends_at]", booking.ends_at&.iso8601

    - if several
      div class="flex justify-between gap-4 text-base"
        span class="font-semibold" = t(".grand_total", count: bookings.size)
        span class="font-bold text-emerald-700 tabular-nums" = format_vnd(@batch.total_amount_vnd)

    div class="rounded-lg bg-slate-50 p-4 text-sm"
      p class="mb-1 font-medium" = t(".customer")
      p = "#{current_user.full_name} · #{PhoneNumber.to_local(current_user.phone)}"
      p class="mt-1 text-xs text-slate-500"
        = t(".customer_hint_html", link: link_to(t(".account_settings"), edit_user_registration_path, class: "link"))

    div
      = f.label :note, Booking.human_attribute_name(:note), class: "form-label"
      = f.text_area :note, value: bookings.first&.note, rows: 2, maxlength: 500, placeholder: t(".note_placeholder"), class: "form-input"

    p class="rounded-lg bg-amber-50 px-4 py-3 text-sm text-amber-800 ring-1 ring-amber-200" = t(".pay_at_venue")

    div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end"
      = link_to t(".back"), root_path(date: bookings.first&.starts_at&.to_date&.iso8601), class: "btn-secondary"
      - unless @batch.errors?
        = f.submit t(".submit"), class: "btn-primary"
