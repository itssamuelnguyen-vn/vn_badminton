- content_for :title, t(".title", code: @booking.code)

div class="card mx-auto max-w-lg overflow-hidden"
  / The code on a brand band across the top of the card.
  div class="brand-gradient relative -mx-6 -mt-6 mb-6 flex items-start justify-between gap-4 overflow-hidden px-6 py-6 text-white sm:-mx-8 sm:-mt-8 sm:px-8"
    div class="pointer-events-none absolute -top-16 -right-10 size-48 rounded-full bg-white/10" aria-hidden="true"
    div class="relative"
      p class="text-sm text-emerald-50/80" = Booking.human_attribute_name(:code)
      p class="font-mono text-2xl font-bold tracking-widest" = @booking.code
    div class="relative" = booking_status_badge(@booking)

  = render "bookings/details", booking: @booking

  - if @booking.series_id
    p class="mt-4 rounded-2xl bg-sky-50 px-4 py-3 text-sm text-sky-900 ring-1 ring-sky-200" = t(".series_note")

  - if @booking.note.present?
    p class="mt-4 rounded-2xl bg-slate-50 p-3 text-sm text-slate-700" = @booking.note

  - if @booking.pending? && @booking.payment&.open?
    div class="mt-4 flex flex-wrap items-center justify-between gap-3 rounded-2xl bg-violet-50 px-4 py-3 text-sm text-violet-900 ring-1 ring-violet-200"
      p = t(".awaiting_payment", time: l(@booking.payment.expires_at, format: :hour_minute))
      = link_to t("bookings.index.pay_now"), payment_path(@booking.payment), class: "btn-primary px-3 py-1.5 text-xs"
  - elsif @booking.payment_unpaid? && !@booking.cancelled?
    p class="mt-4 rounded-2xl bg-amber-50 px-4 py-3 text-sm text-amber-800 ring-1 ring-amber-200" = t("bookings.new.pay_at_venue")

  - if @booking.kind_reservation? && @booking.status.in?(BookingsController::UPCOMING_STATUSES) && @booking.ends_at.future?
    = render "bookings/group_share", booking: @booking
  / Rating the session once it is played (TI-03), then the rating given.
  - if (review = @booking.review)
    div class="mt-4 rounded-2xl bg-amber-50 px-4 py-3 text-sm text-amber-950 ring-1 ring-amber-200"
      p class="font-semibold" = t(".review.yours")
      p class="mt-1 text-lg tracking-wider text-amber-500" role="img" aria-label=t(".review.stars", count: review.rating)
        = "★" * review.rating
        span class="text-amber-200" = "★" * (5 - review.rating)
      - if review.comment
        p class="mt-1 whitespace-pre-line text-slate-700" = review.comment
  - elsif @booking.reviewable?
    = form_with scope: :review, url: review_booking_path(@booking), class: "mt-4 space-y-3 rounded-2xl bg-amber-50 px-4 py-4 ring-1 ring-amber-200" do |f|
      fieldset
        legend class="text-sm font-semibold text-amber-950" = t(".review.title")
        p class="mb-2 text-xs text-amber-900" = t(".review.hint")
        / Five stars right to left in the markup, shown left to right: a checked or hovered star lights up the ones
        / after it in the markup, i.e. the lower ones on screen.
        div class="flex w-fit flex-row-reverse justify-end gap-1 rounded-lg has-focus-visible:ring-2 has-focus-visible:ring-amber-400"
          - 5.downto(1) do |rating|
            = f.radio_button :rating, rating, required: true, class: "peer sr-only"
            = f.label :rating, value: rating, class: "peer cursor-pointer text-3xl leading-none text-amber-200 transition hover:text-amber-500 peer-checked:text-amber-500 peer-hover:text-amber-500" do
              span aria-hidden="true" = "★"
              span.sr-only = t(".review.stars", count: rating)
      div
        = f.label :comment, Review.human_attribute_name(:comment), class: "form-label"
        = f.text_area :comment, rows: 2, maxlength: 1000, placeholder: t(".review.comment_placeholder"), class: "form-input bg-white"
      = f.submit t(".review.submit"), class: "btn-primary w-full sm:w-auto"

  / Warn before the cancellation that would lock online booking (Venue#cancellation_lock_threshold).
  - venue = @booking.court.venue
  - if @booking.cancellable_by_customer? && @booking.series_id.nil? && current_user.cancellations_today(venue) + 1 >= venue.cancellation_lock_threshold
    p class="mt-4 rounded-2xl bg-red-50 px-4 py-3 text-sm text-red-800 ring-1 ring-red-200" role="note"
      = t(".lock_warning", count: venue.cancellation_lock_threshold, days: venue.cancellation_lock_days)

  div class="mt-6 flex flex-col-reverse gap-3 sm:flex-row sm:justify-between"
    = link_to t(".all_bookings"), bookings_path, class: "btn-secondary"
    - if @booking.reschedulable_by_customer?
      = link_to t(".reschedule"), root_path(date: @booking.starts_at.in_time_zone(@booking.court.venue.zone).to_date.iso8601, reschedule: @booking.code),
          class: "btn-secondary"
    - if @booking.cancellable_by_customer?
      = button_to (@booking.series_id ? t(".skip") : t(".cancel")), cancel_booking_path(@booking), method: :patch, class: "btn w-full bg-red-600 text-white hover:bg-red-700",
          form: { data: { turbo_confirm: (@booking.series_id ? t(".skip_confirm") : @booking.payment_paid? ? t(".cancel_confirm_paid") : t(".cancel_confirm")) } }
    - elsif @booking.confirmed?
      p class="text-xs text-slate-500 sm:text-right" = t(".cancel_cutoff", hours: @booking.court.venue.cancellation_cutoff_hours)
