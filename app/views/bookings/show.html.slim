- content_for :title, t(".title", code: @booking.code)

div class="card mx-auto max-w-lg"
  div class="mb-6 flex items-start justify-between gap-4"
    div
      p class="text-sm text-slate-500" = Booking.human_attribute_name(:code)
      p class="font-mono text-2xl font-bold tracking-widest" = @booking.code
    = booking_status_badge(@booking)

  = render "bookings/details", booking: @booking

  - if @booking.series_id
    p class="mt-4 rounded-lg bg-sky-50 px-4 py-3 text-sm text-sky-900 ring-1 ring-sky-200" = t(".series_note")

  - if @booking.note.present?
    p class="mt-4 rounded-lg bg-slate-50 p-3 text-sm text-slate-700" = @booking.note

  - if @booking.payment_unpaid? && !@booking.cancelled?
    p class="mt-4 rounded-lg bg-amber-50 px-4 py-3 text-sm text-amber-800 ring-1 ring-amber-200" = t("bookings.new.pay_at_venue")

  / Warn before the cancellation that would lock online booking (Venue#cancellation_lock_threshold).
  - venue = @booking.court.venue
  - if @booking.cancellable_by_customer? && @booking.series_id.nil? && current_user.cancellations_today(venue) + 1 >= venue.cancellation_lock_threshold
    p class="mt-4 rounded-lg bg-red-50 px-4 py-3 text-sm text-red-800 ring-1 ring-red-200" role="note"
      = t(".lock_warning", count: venue.cancellation_lock_threshold, days: venue.cancellation_lock_days)

  div class="mt-6 flex flex-col-reverse gap-3 sm:flex-row sm:justify-between"
    = link_to t(".all_bookings"), bookings_path, class: "btn-secondary"
    - if @booking.reschedulable_by_customer?
      = link_to t(".reschedule"), root_path(date: @booking.starts_at.in_time_zone(@booking.court.venue.zone).to_date.iso8601, reschedule: @booking.code),
          class: "btn-secondary"
    - if @booking.cancellable_by_customer?
      = button_to (@booking.series_id ? t(".skip") : t(".cancel")), cancel_booking_path(@booking), method: :patch, class: "btn w-full bg-red-600 text-white hover:bg-red-700",
          form: { data: { turbo_confirm: (@booking.series_id ? t(".skip_confirm") : t(".cancel_confirm")) } }
    - elsif @booking.confirmed?
      p class="text-xs text-slate-500 sm:text-right" = t(".cancel_cutoff", hours: @booking.court.venue.cancellation_cutoff_hours)
