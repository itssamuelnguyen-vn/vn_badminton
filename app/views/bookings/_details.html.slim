/ Court, date, time and price of a booking (new, unsaved bookings included).
dl class="divide-y divide-slate-100 text-sm"
  div class="flex justify-between gap-4 py-2"
    dt class="text-slate-500" = Booking.human_attribute_name(:court)
    dd class="font-medium" = booking.court.name
  div class="flex justify-between gap-4 py-2"
    dt class="text-slate-500" = t("bookings.details.date")
    dd class="font-medium" = l(booking.starts_at.to_date, format: :full)
  div class="flex justify-between gap-4 py-2"
    dt class="text-slate-500" = t("bookings.details.time")
    dd class="font-medium tabular-nums" = "#{time_range(booking.starts_at, booking.ends_at)} (#{format_duration(booking.duration_minutes)})"
  - if booking.price_breakdown.size > 1
    - booking.price_breakdown.each do |line|
      div class="flex justify-between gap-4 py-2 text-slate-500"
        dt class="tabular-nums" = "#{time_range(Time.zone.parse(line["from"]), Time.zone.parse(line["to"]))} · #{t("schedules.price_list.per_hour", price: format_vnd(line["price_per_hour_vnd"]))}"
        dd class="tabular-nums" = format_vnd(line["amount_vnd"])
  div class="flex justify-between gap-4 py-3 text-base"
    dt class="font-semibold" = t("bookings.details.total")
    dd class="font-bold text-emerald-700 tabular-nums" = format_vnd(booking.total_amount_vnd)
