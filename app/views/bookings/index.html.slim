- content_for :title, t(".title")

div class="mx-auto max-w-2xl"
  div class="mb-8 flex flex-wrap items-center justify-between gap-4"
    h1 class="text-2xl font-bold sm:text-3xl" = t(".title")
    = link_to root_path, class: "btn-primary" do
      svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"
        path d="M12 5v14M5 12h14"
      = t(".new")

  = render "bookings/lock_notice"

  - if @awaiting_payments.any?
    section class="mb-10"
      h2 class="section-title mb-4" = t(".awaiting_payment")
      div class="space-y-3"
        - @awaiting_payments.each do |payment|
          = link_to payment_path(payment), class: "flex items-center justify-between gap-4 rounded-3xl bg-gradient-to-br from-amber-50 to-orange-100 p-4 ring-1 ring-orange-200 transition hover:-translate-y-0.5 hover:ring-orange-300 sm:p-5" do
            span class="flex items-center gap-3 text-sm text-orange-950"
              span class="flex size-10 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br from-amber-400 to-orange-500 text-white shadow-md shadow-orange-500/30" aria-hidden="true"
                svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                  circle cx="12" cy="12" r="9"
                  path d="M12 7v5l3 2"
              = t(".awaiting_payment_line", amount: format_vnd(payment.amount_vnd), time: l(payment.expires_at, format: :hour_minute))
            span class="btn-primary shrink-0 px-4 py-1.5 text-xs" = t(".pay_now")

  section class="mb-10"
    h2 class="section-title mb-4" = t(".upcoming")
    - if @upcoming.any?
      div class="space-y-3"
        = render @upcoming
    - else
      div class="card flex flex-col items-center gap-3 text-center"
        span class="flex size-14 items-center justify-center rounded-2xl bg-emerald-50 text-emerald-600" aria-hidden="true"
          svg class="size-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
            rect x="3.5" y="5" width="17" height="15" rx="3"
            path d="M3.5 10h17M8 3v4M16 3v4"
        p class="text-sm text-slate-600" = t(".no_upcoming")
        = link_to t(".new"), root_path, class: "btn-primary mt-1"

  - if @past.any?
    section
      h2 class="section-title mb-4" = t(".past")
      div class="space-y-3"
        = render @past
