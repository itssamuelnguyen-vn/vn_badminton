- content_for :title, t(".title")

div class="mx-auto max-w-2xl"
  div class="mb-8 flex flex-wrap items-center justify-between gap-4"
    h1 class="text-2xl font-bold sm:text-3xl" = t(".title")
    div class="flex gap-2"
      = link_to t(".packages"), packages_path, class: "btn-secondary"
      = link_to root_path, class: "btn-primary" do
        svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"
          path d="M12 5v14M5 12h14"
        = t(".new")

  / Groups and weekly bookings live here rather than in the header, which stays short on phones.
  div class="mb-8 grid grid-cols-2 gap-3"
    - [ [ groups_path, ".groups", ".groups_hint", "M9 11.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7ZM2.5 20a6.5 6.5 0 0 1 13 0M16 4.5a3.5 3.5 0 0 1 0 7M18 14.5a6.5 6.5 0 0 1 3.5 5.5" ],
        [ series_index_path, ".series", ".series_hint", "M3.5 7a2 2 0 0 1 2-2h13a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-13a2 2 0 0 1-2-2ZM3.5 10h17M8 3v4M16 3v4M8 14h.01M12 14h.01M16 14h.01M8 17.5h.01M12 17.5h.01" ] ].each do |path, label, hint, icon|
      = link_to path, class: "surface group flex items-center gap-3 p-3 transition hover:-translate-y-0.5 hover:ring-emerald-300 sm:p-4" do
        span class="flex size-10 shrink-0 items-center justify-center rounded-2xl bg-emerald-50 text-emerald-600 ring-1 ring-emerald-100" aria-hidden="true"
          svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
            path d=icon
        span class="min-w-0"
          span class="block font-semibold" = t(label)
          span class="block truncate text-xs text-slate-500" = t(hint)

  = render "bookings/lock_notice"

  - if @awaiting_payments.any?
    section class="mb-10"
      h2 class="section-title mb-4" = t(".awaiting_payment")
      div class="space-y-3"
        - @awaiting_payments.each do |payment|
          = link_to payment_path(payment), class: "flex items-center justify-between gap-4 rounded-3xl bg-gradient-to-br from-amber-50 to-orange-100 p-4 ring-1 ring-orange-200 transition hover:-translate-y-0.5 hover:ring-orange-300 sm:p-5" do
            span class="flex items-center gap-3 text-sm text-orange-950"
              span class="flex size-10 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br from-amber-400 to-orange-500 text-white shadow-md shadow-orange-500/30" aria-hidden="true"
                svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                  circle cx="12" cy="12" r="9"
                  path d="M12 7v5l3 2"
              = t(".awaiting_payment_line", amount: format_vnd(payment.amount_vnd), time: l(payment.expires_at, format: :hour_minute))
            span class="btn-primary shrink-0 px-4 py-1.5 text-xs" = t(".pay_now")

  section class="mb-10"
    h2 class="section-title mb-4" = t(".upcoming")
    - if @upcoming.any?
      div class="space-y-3"
        = render @upcoming
    - else
      div class="card flex flex-col items-center gap-3 text-center"
        span class="flex size-14 items-center justify-center rounded-2xl bg-emerald-50 text-emerald-600" aria-hidden="true"
          svg class="size-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
            rect x="3.5" y="5" width="17" height="15" rx="3"
            path d="M3.5 10h17M8 3v4M16 3v4"
        p class="text-sm text-slate-600" = t(".no_upcoming")
        = link_to t(".new"), root_path, class: "btn-primary mt-1"

  / "Báo khi có sân trống" (TI-04): added from the schedule.
  - if @waits.any?
    section class="mb-10"
      h2 class="section-title mb-1" = t(".waits")
      p class="mb-4 text-sm text-slate-600" = t(".waits_hint")
      ul class="space-y-2"
        - @waits.each do |entry|
          li class="surface flex items-center justify-between gap-3 px-4 py-3"
            span class="flex min-w-0 items-center gap-3 text-sm"
              span class="flex size-9 shrink-0 items-center justify-center rounded-xl bg-sky-50 text-sky-600" aria-hidden="true"
                svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                  path d="M6 8a6 6 0 1 1 12 0c0 7 3 9 3 9H3s3-2 3-9M10.3 21a1.94 1.94 0 0 0 3.4 0"
              span
                span class="block font-semibold" = l(entry.starts_at.to_date, format: :full)
                span class="block text-slate-600 tabular-nums" = time_range(entry.starts_at, entry.ends_at)
            = button_to t(".stop_waiting"), waitlist_entry_path(entry), method: :delete, class: "btn-secondary shrink-0 px-3 py-1.5 text-xs"

  - if @past.any?
    section
      h2 class="section-title mb-4" = t(".past")
      div class="space-y-3"
        = render @past
