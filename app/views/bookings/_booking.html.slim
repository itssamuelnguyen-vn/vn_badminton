= link_to booking_path(booking), class: "flex items-center justify-between gap-4 rounded-xl bg-white p-4 ring-1 ring-slate-200 transition hover:ring-emerald-400" do
  div
    p class="font-semibold"
      = "#{booking.court.display_name} · #{l(booking.starts_at.to_date, format: :full)}"
    p class="text-sm text-slate-600 tabular-nums"
      = "#{time_range(booking.starts_at, booking.ends_at)} · #{format_vnd(booking.total_amount_vnd)}"
    p class="mt-1 font-mono text-xs text-slate-400" = booking.code
  = booking_status_badge(booking)
