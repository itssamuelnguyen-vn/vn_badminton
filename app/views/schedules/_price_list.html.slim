section class="mt-12" aria-labelledby="price-list-title"
  h2#price-list-title class="section-title mb-4" = t(".title")
  / One card per price rule: name and days, hours, price per hour.
  ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3"
    - venue.price_rules.active.where(court_id: nil).order(:priority, :start_minute).each do |rule|
      li class="surface flex flex-col gap-3 p-5"
        div
          p class="font-bold" = rule.display_name
          p class="mt-0.5 text-sm text-slate-500"
            = "#{format_days(rule.days_of_week)} · #{OpeningHour.format_minute(rule.start_minute)} – #{OpeningHour.format_minute(rule.end_minute)}"
        p class="mt-auto bg-gradient-to-r from-emerald-700 to-teal-500 bg-clip-text text-2xl font-bold text-transparent tabular-nums"
          = t(".per_hour", price: format_vnd(rule.price_per_hour_vnd))
  p class="mt-3 text-xs text-slate-500" = t(".note")
