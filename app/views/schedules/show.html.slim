- content_for :title, t(".title")

div class="mb-6 flex flex-wrap items-end justify-between gap-4"
  div
    h1 class="text-2xl font-bold sm:text-3xl" = t(".title")
    p class="mt-1 text-sm text-slate-600" = "#{@venue.name} · #{@venue.address}"

/ Date picker: today up to the booking horizon.
nav class="-mx-4 mb-4 flex gap-2 overflow-x-auto px-4 pb-2 sm:mx-0 sm:px-0" aria-label=t(".dates")
  - @venue.bookable_dates.each do |date|
    = link_to root_path(date: date.iso8601),
        aria: { current: ("date" if date == @date) },
        class: [ "flex min-w-16 flex-col items-center rounded-lg px-3 py-2 text-sm ring-1 transition",
                 date == @date ? "bg-emerald-600 text-white ring-emerald-600" : "bg-white text-slate-700 ring-slate-200 hover:ring-emerald-400" ] do
      span class="text-xs font-medium whitespace-nowrap uppercase" = date == @venue.today ? t(".today") : l(date, format: :weekday)
      span class="font-semibold" = l(date, format: :day_month)

- if @day.open?
  = render "schedules/legend"

  div data-controller="slot-picker" data-slot-picker-new-url-value=new_booking_path data-slot-picker-min-minutes-value=@venue.min_booking_minutes data-slot-picker-max-minutes-value=@venue.max_booking_minutes data-slot-picker-currency-value=t("helpers.vnd") data-slot-picker-locale-value=t(".number_locale") data-slot-picker-too-short-value=t(".too_short", minutes: @venue.min_booking_minutes) data-slot-picker-too-long-value=t(".too_long", minutes: @venue.max_booking_minutes)
    = render "schedules/grid", day: @day

    / Summary of the current selection, filled in by the slot-picker controller.
    div class="sticky bottom-0 z-20 -mx-4 mt-4 border-t border-slate-200 bg-white/95 px-4 py-3 backdrop-blur sm:mx-0 sm:rounded-xl sm:border sm:shadow-lg" hidden=true data-slot-picker-target="summary"
      div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-3"
        div
          p class="font-semibold" data-slot-picker-target="summaryText"
          p class="text-xs text-red-700" data-slot-picker-target="hint"
        = link_to t(".continue"), new_booking_path, class: "btn-primary aria-disabled:pointer-events-none aria-disabled:opacity-50", data: { slot_picker_target: "continue" }
- else
  div class="card text-center text-slate-600" = t(".closed")

= render "schedules/price_list", venue: @venue
