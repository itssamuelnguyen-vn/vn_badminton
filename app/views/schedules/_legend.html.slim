ul class="flex flex-wrap gap-x-4 gap-y-2 text-xs text-slate-600" aria-label=t(".label")
  li class="flex items-center gap-1.5"
    span class="size-3.5 rounded bg-white ring-1 ring-slate-300"
    = t(".available")
  li class="flex items-center gap-1.5"
    span class="size-3.5 rounded bg-emerald-600"
    = t(".selected")
  li class="flex items-center gap-1.5"
    span class="size-3.5 rounded bg-sky-100 ring-1 ring-sky-300"
    = t(".mine")
  li class="flex items-center gap-1.5"
    span class="size-3.5 rounded bg-slate-200"
    = t(".booked")
  li class="flex items-center gap-1.5"
    span class="size-3.5 rounded bg-amber-100 ring-1 ring-amber-300"
    = t(".blocked")
  li class="flex items-center gap-1.5"
    span class="slot-unavailable size-3.5 rounded ring-1 ring-slate-200"
    = t(".unavailable")
