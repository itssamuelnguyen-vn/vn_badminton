- item = "flex items-center gap-1.5 rounded-full bg-white px-2.5 py-1 shadow-sm ring-1 ring-slate-200"
ul class="flex flex-wrap gap-1.5 text-xs font-medium text-slate-600" aria-label=t(".label")
  li class=item
    span class="size-3 rounded-full bg-white ring-1 ring-slate-300"
    = t(".available")
  li class=item
    span class="size-3 rounded-full bg-gradient-to-br from-emerald-600 to-teal-500"
    = t(".selected")
  li class=item
    span class="size-3 rounded-full bg-sky-100 ring-1 ring-sky-300"
    = t(".mine")
  li class=item
    span class="size-3 rounded-full bg-slate-100 ring-1 ring-slate-300"
    = t(".booked")
  li class=item
    span class="size-3 rounded-full bg-violet-50 ring-1 ring-violet-300"
    = t(".held")
  li class=item
    span class="size-3 rounded-full bg-amber-100 ring-1 ring-amber-300"
    = t(".blocked")
  li class=item
    span class="slot-unavailable size-3 rounded-full ring-1 ring-slate-200"
    = t(".unavailable")
