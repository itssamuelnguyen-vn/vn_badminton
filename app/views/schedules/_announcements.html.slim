/ The owner's news (Announcement), also shown in the app: a coloured icon per tone.
- styles = { "info" => [ "bg-sky-50 text-sky-950 ring-sky-200", "from-sky-400 to-blue-500", "M12 8h.01M11 12h1v5h1" ],
             "offer" => [ "bg-emerald-50 text-emerald-950 ring-emerald-200", "from-emerald-500 to-teal-500", "M20 12v8H4v-8M2 7h20v5H2zM12 20V7m0 0H7.5a2.5 2.5 0 1 1 0-5C11 2 12 7 12 7Zm0 0h4.5a2.5 2.5 0 1 0 0-5C13 2 12 7 12 7Z" ],
             "warning" => [ "bg-amber-50 text-amber-950 ring-amber-200", "from-amber-400 to-orange-500", "M12 9v4m0 4h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z" ] }
- announcements.each do |announcement|
  - classes, gradient, icon = styles.fetch(announcement.tone)
  div class="mb-4 flex items-start gap-3 rounded-3xl px-4 py-3.5 text-sm ring-1 #{classes}" role="note"
    span class="flex size-9 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br text-white shadow-sm #{gradient}" aria-hidden="true"
      svg class="size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
        path d=icon
    div class="min-w-0 pt-1"
      p class="font-bold" = announcement.display_title
      - if announcement.display_body
        p class="mt-1 whitespace-pre-line opacity-90" = announcement.display_body
