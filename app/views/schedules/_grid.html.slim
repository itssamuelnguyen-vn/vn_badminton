/ Rows are 30-minute slots, columns are courts. Scrolls in both directions on small screens,
/ with the court names and the times kept in view.
div class="surface max-h-[70vh] overflow-auto"
  div class="grid text-sm" style="grid-template-columns: 4rem repeat(#{day.courts.size}, minmax(4.5rem, 1fr))" role="grid" aria-label=t(".label", date: l(day.date, format: :full))
    div class="sticky top-0 left-0 z-20 border-b border-emerald-100 bg-emerald-50"
    - day.courts.each do |court|
      div class="sticky top-0 z-10 border-b border-l border-emerald-100 bg-emerald-50 px-2 py-3 text-center font-bold text-emerald-900" role="columnheader" = court.display_name

    - day.upcoming_times.each_with_index do |time, index|
      div class="sticky left-0 z-10 border-b border-slate-100 bg-white px-2 py-2.5 text-right text-xs font-semibold text-slate-500 tabular-nums" role="rowheader"
        = l(time, format: :hour_minute)
      - day.courts.each do |court|
        - slot = day.slot(court, time)
        - label = "#{court.display_name}, #{time_range(slot.starts_at, slot.ends_at)}: #{t(".states.#{slot.state}")}"
        - cell_data = { court_id: court.id, court_name: court.display_name, index: index, starts_at: slot.starts_at.iso8601, ends_at: slot.ends_at.iso8601,
                        starts_label: l(slot.starts_at, format: :hour_minute), ends_label: l(slot.ends_at, format: :hour_minute), price: slot.price_vnd }
        - if slot.available?
          / A "+" shows on hover; picked cells get the brand gradient.
          = tag.button type: "button", aria: { pressed: "false", label: label },
              class: "group h-10 cursor-pointer border-b border-l border-slate-100 bg-white text-lg leading-none font-bold text-emerald-500 transition hover:bg-emerald-50 aria-pressed:bg-gradient-to-br aria-pressed:from-emerald-600 aria-pressed:to-teal-500 aria-pressed:text-white",
              data: cell_data.merge(available: true, action: "slot-picker#select") do
            span class="opacity-0 transition group-hover:opacity-100 group-aria-pressed:opacity-100" aria-hidden="true"
              span class="group-aria-pressed:hidden" = "+"
              span class="hidden group-aria-pressed:inline" = "✓"
        - else
          = tag.div title: label, data: cell_data,
              class: [ "flex h-10 items-center justify-center border-b border-l border-slate-100 text-[11px] font-medium",
                       { "booked" => "bg-slate-100 text-slate-400", "held" => "bg-violet-50 text-violet-700", "mine" => "bg-sky-100 font-medium text-sky-800",
                         "blocked" => "bg-amber-100 text-amber-800", "unavailable" => "slot-unavailable" }.fetch(slot.state.to_s) ] do
            - unless slot.state == :unavailable
              span = t(".states.#{slot.state}")
