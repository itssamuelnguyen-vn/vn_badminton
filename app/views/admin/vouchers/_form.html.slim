= form_with model: [ :admin, voucher ], class: "space-y-5" do |f|
  = render "devise/shared/error_messages", resource: voucher

  div class="grid grid-cols-2 gap-3"
    div
      = f.label :code, class: "form-label"
      = f.text_field :code, maxlength: 20, required: true, placeholder: "HE2026", class: "form-input font-mono uppercase"
    div
      = f.label :kind, class: "form-label"
      = f.select :kind, Voucher::KINDS.map { |kind| [ t("admin.vouchers.kinds.#{kind}"), kind ] }, {}, class: "form-input"
  div
    = f.label :description, class: "form-label"
    = f.text_field :description, maxlength: 100, class: "form-input"
  div class="grid grid-cols-2 gap-3"
    div
      = f.label :value, class: "form-label"
      = f.number_field :value, min: 1, required: true, class: "form-input"
      p class="form-hint" = t("admin.vouchers.form.value_hint")
    div
      = f.label :max_discount_vnd, class: "form-label"
      = f.number_field :max_discount_vnd, min: 1000, step: 1000, class: "form-input"
  div class="grid grid-cols-2 gap-3"
    div
      = f.label :valid_from, class: "form-label"
      = f.date_field :valid_from, required: true, class: "form-input"
    div
      = f.label :valid_until, class: "form-label"
      = f.date_field :valid_until, required: true, class: "form-input"
  fieldset
    legend class="form-label" = Voucher.human_attribute_name(:days_of_week)
    div class="flex flex-wrap gap-2"
      = f.collection_check_boxes :days_of_week, Admin::VenueSettings::WEEK.map { |day| [ day, t("date.abbr_day_names")[day] ] }, :first, :last do |b|
        = b.label class: "flex cursor-pointer items-center gap-1.5 rounded-lg px-3 py-1.5 text-sm ring-1 ring-slate-300 has-checked:bg-emerald-50 has-checked:ring-emerald-500" do
          = b.check_box class: "accent-emerald-600"
          = b.text
    p class="form-hint" = t("admin.vouchers.form.days_hint")
  div class="grid grid-cols-2 gap-3"
    div
      = f.label :start_minute, class: "form-label"
      = f.select :start_minute, minute_options(0..1410), { include_blank: t("admin.vouchers.form.any_time") }, class: "form-input"
    div
      = f.label :end_minute, class: "form-label"
      = f.select :end_minute, minute_options(30..1440), { include_blank: t("admin.vouchers.form.any_time") }, class: "form-input"
  div class="grid grid-cols-3 gap-3"
    div
      = f.label :min_amount_vnd, class: "form-label"
      = f.number_field :min_amount_vnd, min: 0, step: 1000, class: "form-input"
    div
      = f.label :usage_limit, class: "form-label"
      = f.number_field :usage_limit, min: 1, class: "form-input"
    div
      = f.label :per_user_limit, class: "form-label"
      = f.number_field :per_user_limit, min: 1, required: true, class: "form-input"
  label class="flex items-center gap-2 text-sm"
    = f.check_box :active, class: "size-4 accent-emerald-600"
    = t("admin.vouchers.form.active")

  div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end"
    = link_to t("admin.vouchers.form.back"), admin_vouchers_path, class: "btn-secondary"
    = f.submit t("admin.vouchers.form.submit"), class: "btn-primary"
