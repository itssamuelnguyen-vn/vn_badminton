- content_for :title, t(".title")

div class="mb-4 flex flex-wrap items-end justify-between gap-4"
  div
    h1 class="text-2xl font-bold sm:text-3xl" = t(".title")
    p class="mt-1 text-sm text-slate-600" = t(".explanation")
  = link_to t(".new"), new_admin_series_path, class: "btn-primary"

- if @requests.any?
  section class="mb-6" aria-labelledby="series-requests-title"
    h2#series-requests-title class="mb-2 text-lg font-semibold" = t(".requests", count: @requests.size)
    div class="divide-y divide-amber-100 rounded-xl bg-amber-50 ring-1 ring-amber-200"
      - @requests.each do |series_request|
        div class="flex flex-wrap items-start justify-between gap-3 px-4 py-3"
          div
            p class="font-semibold"
              = series_request.user.full_name
              span class="ml-2 text-sm font-normal text-slate-600" = PhoneNumber.to_local(series_request.user.phone)
            p class="text-sm text-slate-700"
              = "#{series_request.courts.map(&:display_name).join(", ")} · #{format_days(series_request.days_of_week)} #{OpeningHour.format_minute(series_request.start_minute)} – #{OpeningHour.format_minute(series_request.end_minute)}"
              = " · #{l(series_request.starts_on, format: :day_month_year)} – #{l(series_request.ends_on, format: :day_month_year)}"
            - if series_request.note
              p class="text-sm text-slate-600" = series_request.note
          div class="flex flex-wrap items-center gap-2"
            = link_to t(".create_from_request"), new_admin_series_path(request_id: series_request.id), class: "btn-primary px-3 py-1.5 text-xs"
            details class="text-sm"
              summary class="btn-secondary cursor-pointer px-3 py-1.5 text-xs" = t(".decline")
              = form_with url: decline_admin_series_request_path(series_request), method: :patch, class: "mt-2 flex gap-2" do |f|
                = f.text_field :decline_reason, maxlength: 200, placeholder: t(".decline_reason"), class: "form-input py-1.5 text-sm"
                = f.submit t(".decline_submit"), class: "btn-secondary px-3 py-1.5 text-xs"

- if @series.any?
  div class="divide-y divide-slate-100 rounded-xl bg-white ring-1 ring-slate-200"
    - @series.each do |series|
      = link_to admin_series_path(series), class: "flex flex-wrap items-center justify-between gap-3 px-4 py-3 hover:bg-slate-50" do
        div
          p class="font-semibold" = series.customer_name
          p class="text-sm text-slate-600"
            = "#{series.courts.map(&:display_name).join(", ")} · #{format_days(series.days_of_week)} #{OpeningHour.format_minute(series.start_minute)} – #{OpeningHour.format_minute(series.end_minute)}"
        p class=[ "text-xs", series.ends_on < Venue.main.today ? "text-slate-400" : "text-slate-600" ]
          = "#{l(series.starts_on, format: :day_month_year)} – #{l(series.ends_on, format: :day_month_year)}"
- else
  p class="card text-center text-sm text-slate-600" = t(".empty")
