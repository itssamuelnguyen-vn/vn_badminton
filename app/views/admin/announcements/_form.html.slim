= form_with model: [ :admin, announcement ], class: "space-y-5" do |f|
  = render "devise/shared/error_messages", resource: announcement

  div
    = f.label :title, class: "form-label"
    = f.text_field :title, maxlength: 100, required: true, placeholder: t("admin.announcements.form.title_placeholder"), class: "form-input"
  div
    = f.label :body, class: "form-label"
    = f.text_area :body, maxlength: 1000, rows: 3, class: "form-input"
  div
    = f.label :title_en, class: "form-label"
    = f.text_field :title_en, maxlength: 100, class: "form-input"
  div
    = f.label :body_en, class: "form-label"
    = f.text_area :body_en, maxlength: 1000, rows: 3, class: "form-input"
    p class="form-hint" = t("admin.announcements.form.english_hint")
  div class="grid grid-cols-2 gap-3"
    div
      = f.label :starts_on, class: "form-label"
      = f.date_field :starts_on, required: true, class: "form-input"
    div
      = f.label :ends_on, class: "form-label"
      = f.date_field :ends_on, required: true, class: "form-input"
  div
    = f.label :tone, class: "form-label"
    = f.select :tone, Announcement::TONES.map { |tone| [ t("admin.announcements.tones.#{tone}"), tone ] }, {}, class: "form-input"

  div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end"
    = link_to t("admin.announcements.form.back"), admin_announcements_path, class: "btn-secondary"
    = f.submit t("admin.announcements.form.submit"), class: "btn-primary"
