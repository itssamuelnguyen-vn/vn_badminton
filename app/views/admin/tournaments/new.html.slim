- content_for :title, t(".title")
- tournament = @tournament

div class="card mx-auto max-w-2xl"
  h1 class="mb-2 text-2xl font-bold" = t(".title")
  p class="mb-6 text-sm text-slate-600" = t(".explanation")

  = form_with model: [ :admin, tournament ], class: "space-y-5" do |f|
    = render "devise/shared/error_messages", resource: tournament
    div
      = f.label :title, class: "form-label"
      = f.text_field :title, maxlength: 100, required: true, placeholder: t(".title_placeholder"), class: "form-input"
    div
      = f.label :title_en, class: "form-label"
      = f.text_field :title_en, maxlength: 100, class: "form-input"
    div
      = f.label :description, class: "form-label"
      = f.text_area :description, maxlength: 1000, rows: 3, placeholder: t(".description_placeholder"), class: "form-input"
    div class="grid gap-3 sm:grid-cols-3"
      div
        = f.label :discipline, class: "form-label"
        = f.select :discipline, Tournament::DISCIPLINES.map { |discipline| [ t("tournaments.disciplines.#{discipline}"), discipline ] }, {}, class: "form-input"
      div
        = f.label :gender, class: "form-label"
        = f.select :gender, Tournament::GENDERS.map { |gender| [ t("tournaments.genders.#{gender}"), gender ] }, { include_blank: t("tournaments.genders.open") }, class: "form-input"
        p class="form-hint" = t(".gender_hint")
      div
        = f.label :level, class: "form-label"
        = f.select :level, PlaySession::LEVELS.map { |level| [ t("play_sessions.levels.#{level}"), level ] }, { include_blank: t("play_sessions.levels.any") }, class: "form-input"
    fieldset
      legend class="form-label" = Tournament.human_attribute_name(:play_format)
      div class="grid gap-2 sm:grid-cols-3"
        - Tournament::FORMATS.each do |format|
          label class="flex cursor-pointer flex-col gap-1 rounded-xl p-3 text-sm ring-1 ring-slate-300 has-checked:bg-emerald-50 has-checked:ring-emerald-500"
            span class="flex items-center gap-2 font-semibold"
              = f.radio_button :play_format, format, class: "accent-emerald-600"
              = t("tournaments.formats.#{format}")
            span class="text-xs text-slate-600" = t(".format_hints.#{format}")
    div class="grid grid-cols-2 gap-3"
      div
        = f.label :group_size, class: "form-label"
        = f.number_field :group_size, min: 3, max: 6, class: "form-input"
      div
        = f.label :advance_per_group, class: "form-label"
        = f.select :advance_per_group, [ 1, 2 ], {}, class: "form-input"
      p class="form-hint col-span-2 -mt-1" = t(".groups_hint")
    fieldset
      legend class="form-label" = Tournament.human_attribute_name(:court_ids)
      div class="flex flex-wrap gap-2"
        = f.collection_check_boxes :court_ids, Venue.main.courts.active, :id, :display_name do |b|
          = b.label class: "flex cursor-pointer items-center gap-1.5 rounded-lg px-3 py-1.5 text-sm ring-1 ring-slate-300 has-checked:bg-emerald-50 has-checked:ring-emerald-500" do
            = b.check_box class: "accent-emerald-600"
            = b.text
    div class="grid grid-cols-3 gap-3"
      div
        = f.label :date, Tournament.human_attribute_name(:date), class: "form-label"
        = f.date_field :date, required: true, class: "form-input"
      div
        = f.label :start_minute, Tournament.human_attribute_name(:starts_at), class: "form-label"
        = f.select :start_minute, minute_options(0..1410), {}, class: "form-input"
      div
        = f.label :end_minute, Tournament.human_attribute_name(:ends_at), class: "form-label"
        = f.select :end_minute, minute_options(30..1440), {}, class: "form-input"
    div class="grid grid-cols-2 gap-3"
      div
        = f.label :registration_date, Tournament.human_attribute_name(:registration_closes_at), class: "form-label"
        = f.date_field :registration_date, required: true, class: "form-input"
      div
        = f.label :registration_minute, t(".registration_time"), class: "form-label"
        = f.select :registration_minute, minute_options(0..1410), {}, class: "form-input"
    div class="grid grid-cols-2 gap-3"
      div
        = f.label :max_entries, class: "form-label"
        = f.number_field :max_entries, min: 2, max: 64, required: true, class: "form-input"
        p class="form-hint" = t(".max_entries_hint", count: Tournament::ROUND_ROBIN_MAX)
      div
        = f.label :fee_vnd, class: "form-label"
        = f.number_field :fee_vnd, min: 0, step: 1000, required: true, class: "form-input"
        p class="form-hint" = t(".fee_hint")
    div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end"
      = link_to t(".back"), admin_tournaments_path, class: "btn-secondary"
      = f.submit t(".submit"), class: "btn-primary"
