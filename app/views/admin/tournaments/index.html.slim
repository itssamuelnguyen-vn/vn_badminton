- content_for :title, t(".title")

div class="mb-4 flex flex-wrap items-end justify-between gap-4"
  div
    h1 class="text-2xl font-bold sm:text-3xl" = t(".title")
    p class="mt-1 max-w-2xl text-sm text-slate-600" = t(".explanation")
  = link_to t(".new"), new_admin_tournament_path, class: "btn-primary"

- [ [ t(".upcoming"), @upcoming ], [ t(".past"), @past ] ].each do |heading, tournaments|
  - next if tournaments.empty?
  h2 class="mt-6 mb-2 text-lg font-semibold" = heading
  div class="divide-y divide-slate-100 rounded-xl bg-white ring-1 ring-slate-200"
    - tournaments.each do |tournament|
      = link_to admin_tournament_path(tournament), class: [ "flex flex-wrap items-center justify-between gap-3 px-4 py-3 hover:bg-slate-50", ("text-slate-400 line-through" if tournament.cancelled?) ] do
        div
          p class="font-semibold" = tournament.title
          p class="text-sm text-slate-600"
            = "#{tournament.event_name} · #{t("tournaments.formats.#{tournament.play_format}")} · #{l(tournament.starts_at.to_date, format: :full)} · #{time_range(tournament.starts_at, tournament.ends_at)}"
        div class="flex items-center gap-2 text-xs font-semibold"
          = render "tournaments/status", tournament: tournament
          span class="text-sm font-normal tabular-nums" = t(".entries", taken: tournament.entries_taken, max: tournament.max_entries)
- if @upcoming.empty? && @past.empty?
  p class="card text-center text-sm text-slate-600" = t(".empty")
