- tournament = @tournament
- content_for :title, tournament.title
- now = Time.current
- courts = tournament.courts.to_a

div class="mx-auto max-w-4xl space-y-6"
  div class="flex flex-wrap items-start justify-between gap-4"
    div
      p class="text-sm text-slate-500" = t(".kicker")
      h1 class="text-2xl font-bold" = tournament.title
      p class="mt-1 text-sm text-slate-600"
        = "#{tournament.event_name} · #{t("tournaments.formats.#{tournament.play_format}")} · #{l(tournament.starts_at.to_date, format: :full)} · #{time_range(tournament.starts_at, tournament.ends_at)} · #{courts.map(&:display_name).join(", ")}"
      p class="mt-1 text-sm text-slate-600"
        = t(".summary", fee: format_vnd(tournament.fee_vnd), taken: tournament.entries_taken(now), max: tournament.max_entries,
            closes: l(tournament.registration_closes_at.in_time_zone(tournament.venue.zone), format: :slot))
      div class="mt-2 flex flex-wrap gap-1.5 text-xs font-semibold"
        = render "tournaments/status", tournament: tournament
    div class="flex flex-wrap gap-2"
      = link_to t(".public_page"), tournament_path(tournament), class: "btn-secondary", target: "_blank"
      = link_to t(".back"), admin_tournaments_path, class: "btn-secondary"

  - if tournament.open?
    div class="card flex flex-wrap items-center justify-between gap-3"
      p class="max-w-xl text-sm text-slate-600" = t(".draw_explanation")
      = button_to t(".draw"), draw_admin_tournament_path(tournament), class: "btn-primary",
          form: { data: { turbo_confirm: t(".draw_confirm", entries: tournament.entries.confirmed.count) } }

  section
    h2 class="section-title" = t(".entries")
    - if @entries.any?
      div class="mt-3 divide-y divide-slate-100 rounded-xl bg-white ring-1 ring-slate-200"
        - @entries.each do |entry|
          div class="flex flex-wrap items-center justify-between gap-3 px-4 py-3 text-sm #{"text-slate-400" if entry.cancelled?}"
            div
              p class="font-medium" = entry.display_name
              p class="text-slate-600"
                = [ PhoneNumber.to_local(entry.user.phone), (PhoneNumber.to_local(entry.partner&.phone || entry.partner_phone) if tournament.doubles?),
                    format_vnd(entry.amount_vnd), t(".statuses.#{entry.status}"), (t(".group", name: (64 + entry.group_number).chr) if entry.group_number) ].compact.join(" · ")
                - if entry.refund_vnd
                  = " · #{entry.refunded_at ? t(".refunded") : t(".refund_due", amount: format_vnd(entry.refund_vnd))}"
            div class="flex flex-wrap items-center gap-2"
              - if tournament.open? && entry.confirmed?
                = form_with url: seed_admin_tournament_path(tournament, entry_id: entry.id), method: :patch, class: "flex items-center gap-1.5" do |f|
                  = f.label :seed, t(".seed"), for: "seed_#{entry.id}", class: "text-xs text-slate-500"
                  = f.number_field :seed, value: entry.seed, min: 1, max: 64, id: "seed_#{entry.id}", class: "form-input w-16 px-2 py-1 text-xs"
                  = f.submit t(".save"), class: "btn-secondary px-3 py-1.5 text-xs"
              - elsif entry.seed
                span class="rounded-full bg-amber-50 px-2 py-0.5 text-xs font-semibold text-amber-800" = t(".seeded", seed: entry.seed)
              - if tournament.open? && !entry.cancelled?
                = button_to t(".remove"), remove_entry_admin_tournament_path(tournament, entry_id: entry.id), method: :patch,
                    class: "btn-secondary px-3 py-1.5 text-xs", form: { data: { turbo_confirm: t(".remove_confirm", name: entry.display_name) } }
              - if entry.refund_vnd && !entry.refunded_at && current_user.owner?
                = button_to t(".mark_refunded"), mark_refunded_admin_tournament_path(tournament, entry_id: entry.id), method: :patch, class: "btn-secondary px-3 py-1.5 text-xs"
    - else
      p class="card mt-3 text-center text-sm text-slate-600" = t(".no_entries")

  - if @standings.present?
    section
      h2 class="section-title" = t(".groups")
      div class="mt-3 grid gap-4 md:grid-cols-2"
        - @standings.each do |number, rows|
          = render "tournaments/standings", tournament: tournament, number: number, rows: rows, mine_id: nil, matches: []

  - if @matches.any?
    section
      h2 class="section-title" = t(".matches")
      p class="mt-1 text-sm text-slate-600" = t(".matches_explanation")
      - @matches.reject(&:bye?).group_by { |match| [ match.stage, match.group_number, match.round ] }.each do |(stage, group, _round), list|
        h3 class="mt-5 mb-2 text-sm font-semibold text-slate-700"
          = stage == "group" && tournament.groups_knockout? ? "#{t("tournaments.standings.group", name: (64 + group).chr)} · #{list.first.round_name}" : list.first.round_name
        div class="divide-y divide-slate-100 rounded-xl bg-white ring-1 ring-slate-200"
          - list.each do |match|
            = render "admin/tournaments/match", tournament: tournament, match: match, courts: courts

  - if (tournament.open? || tournament.in_progress?) && tournament.ends_at > now
    = button_to t(".cancel"), cancel_admin_tournament_path(tournament), method: :patch,
        class: "btn bg-white text-red-700 ring-1 ring-red-200 hover:bg-red-50",
        form: { data: { turbo_confirm: t(".cancel_confirm") } }
