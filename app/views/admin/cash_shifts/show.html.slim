- content_for :title, t(".title")
- shift = @shift

div class="mx-auto max-w-3xl space-y-6"
  div class="flex flex-wrap items-start justify-between gap-4"
    div
      p class="text-sm text-slate-500" = t(".title")
      h1 class="text-2xl font-bold" = l(shift.opened_at, format: :slot)
      p class="mt-1 text-sm text-slate-600"
        = t(".opened", by: shift.opened_by.full_name)
        - if shift.closed?
          = " · #{t(".closed", time: l(shift.closed_at, format: :slot), by: shift.closed_by.full_name)}"
    = link_to t(".back"), admin_cash_shifts_path(month: shift.opened_at.in_time_zone(Venue.main.zone).strftime("%Y-%m")), class: "btn-secondary"

  section class="rounded-2xl bg-white ring-1 ring-slate-200"
    dl class="grid grid-cols-2 gap-3 px-4 py-3 sm:grid-cols-4 sm:px-5"
      - [ [ t("admin.cash_shifts.index.opening"), shift.opening_vnd ], [ t("admin.cash_shifts.index.collected"), shift.collected_vnd ],
          [ t("admin.cash_shifts.index.expected"), shift.expected_vnd ], ([ t(".counted"), shift.counted_vnd ] if shift.closed?) ].compact.each do |label, amount|
        div
          dt class="text-xs text-slate-500" = label
          dd class="mt-0.5 text-lg font-semibold tabular-nums" = format_vnd(amount)
    - if shift.closed?
      div class="border-t border-slate-100 px-4 py-3 sm:px-5"
        p class="font-semibold tabular-nums #{cash_difference_class(shift.difference_vnd)}" = cash_difference(shift.difference_vnd)
        - if shift.note
          p class="mt-1 text-sm text-slate-700" = t("admin.cash_shifts.index.note_line", note: shift.note)
    = render "lines", shift: shift
