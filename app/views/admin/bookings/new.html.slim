- content_for :title, t(".title")
- form = @form

div class="card mx-auto max-w-lg"
  h1 class="mb-6 text-2xl font-bold" = t(".title")

  = form_with scope: :booking, url: admin_bookings_path, class: "space-y-5", data: { controller: "booking-kind" } do |f|
    - if @booking&.errors&.any?
      div#error_explanation role="alert" class="rounded-lg bg-red-50 px-4 py-3 text-sm text-red-800 ring-1 ring-red-200"
        ul class="list-disc space-y-1 pl-5"
          - @booking.errors.full_messages.each do |message|
            li = message

    fieldset
      legend class="form-label" = t(".kind")
      div class="grid grid-cols-2 gap-2"
        - %w[reservation block].each do |kind|
          label class="flex cursor-pointer items-center gap-2 rounded-lg px-3 py-2 text-sm ring-1 ring-slate-300 has-checked:bg-emerald-50 has-checked:ring-emerald-500"
            = f.radio_button :kind, kind, checked: form.kind == kind, class: "accent-emerald-600", data: { action: "booking-kind#toggle" }
            = t(".kinds.#{kind}")

    div
      = f.label :court_id, Booking.human_attribute_name(:court), class: "form-label"
      = f.select :court_id, form.venue.courts.active.map { |court| [ court.display_name, court.id ] }, { selected: form.court_id }, class: "form-input"

    div class="grid grid-cols-3 gap-3"
      div class="col-span-3 sm:col-span-1"
        = f.label :date, t("bookings.details.date"), class: "form-label"
        = f.date_field :date, value: form.date&.iso8601, required: true, class: "form-input"
      div
        = f.label :start_minute, Booking.human_attribute_name(:starts_at), class: "form-label"
        = f.select :start_minute, minute_options(0..1410), { selected: form.start_minute }, class: "form-input"
      div
        = f.label :end_minute, Booking.human_attribute_name(:ends_at), class: "form-label"
        = f.select :end_minute, minute_options(30..1440), { selected: form.end_minute }, class: "form-input"

    / Customer details, hidden for a block.
    div class="space-y-5" hidden=form.block? data-booking-kind-target="customer"
      fieldset
        legend class="form-label" = t(".source")
        div class="grid grid-cols-2 gap-2"
          - Admin::BookingForm::SOURCES.each do |source|
            label class="flex cursor-pointer items-center gap-2 rounded-lg px-3 py-2 text-sm ring-1 ring-slate-300 has-checked:bg-emerald-50 has-checked:ring-emerald-500"
              = f.radio_button :source, source, checked: form.source == source, class: "accent-emerald-600"
              = t("admin.sources.#{source}")
      div
        = f.label :customer_name, Booking.human_attribute_name(:customer_name), class: "form-label"
        = f.text_field :customer_name, value: form.customer_name, maxlength: 100, autocomplete: "off", class: "form-input"
      div
        = f.label :customer_phone, Booking.human_attribute_name(:customer_phone), class: "form-label"
        = f.telephone_field :customer_phone, value: form.customer_phone, autocomplete: "off", placeholder: "0901 234 567", class: "form-input"
        p class="form-hint" = t(".phone_hint")

    div
      = f.label :note, Booking.human_attribute_name(:note), class: "form-label"
      = f.text_area :note, value: form.note, rows: 2, maxlength: 500, class: "form-input",
          placeholder: t(".note_placeholder.#{form.kind}"), data: { booking_kind_target: "note",
          placeholder_reservation: t(".note_placeholder.reservation"), placeholder_block: t(".note_placeholder.block") }

    p class="text-xs text-slate-500" = t(".price_hint")

    div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end"
      = link_to t(".back"), admin_root_path(date: form.date&.iso8601), class: "btn-secondary"
      = f.submit t(".submit"), class: "btn-primary"
