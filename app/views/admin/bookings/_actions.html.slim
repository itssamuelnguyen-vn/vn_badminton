/ The next steps for a booking: cash payment, cancellation. compact: smaller buttons for the day list.
/ No check-in or no-show: a booking is paid before it is played (VH-04).
- size = local_assigns[:compact] ? "px-2.5 py-1 text-xs" : ""

- if booking.kind_reservation? && booking.payment_unpaid? && !booking.cancelled? && !booking.no_show?
  = button_to t("admin.bookings.actions.mark_paid", amount: format_vnd(booking.charged_vnd)), mark_paid_admin_booking_path(booking), method: :patch,
      class: "btn-secondary #{size}", form: { data: { turbo_confirm: t("admin.bookings.actions.mark_paid_confirm", amount: format_vnd(booking.charged_vnd)) } }
- if booking.venue_fault_cancellable?
  = button_to t("admin.bookings.actions.cancel_venue_fault"), cancel_venue_fault_admin_booking_path(booking), method: :patch,
      class: "btn #{size} bg-white text-red-700 ring-1 ring-red-200 hover:bg-red-50",
      form: { data: { turbo_confirm: t("admin.bookings.actions.cancel_venue_fault_confirm", amount: format_vnd(booking.charged_vnd)) } }
- if booking.kind_block? ? !booking.cancelled? : Booking::CUSTOMER_CANCELLABLE_STATUSES.include?(booking.status) && !booking.ended?
  = button_to t("admin.bookings.actions.cancel.#{booking.kind}"), cancel_admin_booking_path(booking), method: :patch,
      class: "btn #{size} bg-white text-red-700 ring-1 ring-red-200 hover:bg-red-50",
      form: { data: { turbo_confirm: t("admin.bookings.actions.cancel_confirm.#{booking.kind}") } }

/ Undo, for actions pressed by mistake.
- undo_class = "btn #{size} bg-white text-slate-600 ring-1 ring-slate-300 hover:bg-slate-50"
- if booking.kind_reservation? && booking.payment_paid?
  = button_to t("admin.bookings.actions.undo_payment"), undo_payment_admin_booking_path(booking), method: :patch, class: undo_class,
      form: { data: { turbo_confirm: t("admin.bookings.actions.undo_payment_confirm", amount: format_vnd(booking.charged_vnd)) } }
