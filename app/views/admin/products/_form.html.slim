= form_with model: [ :admin, product ], class: "space-y-5" do |f|
  = render "devise/shared/error_messages", resource: product

  div
    = f.label :name, class: "form-label"
    = f.text_field :name, maxlength: 60, required: true, placeholder: t("admin.products.form.name_placeholder"), class: "form-input"
  div
    = f.label :name_en, class: "form-label"
    = f.text_field :name_en, maxlength: 60, placeholder: "Racket rental", class: "form-input"
  div class="grid grid-cols-2 gap-3"
    div
      = f.label :price_vnd, class: "form-label"
      = f.number_field :price_vnd, min: 1000, step: 1000, required: true, class: "form-input"
    div
      = f.label :position, class: "form-label"
      = f.number_field :position, step: 1, class: "form-input"
      p class="form-hint" = t("admin.products.form.position_hint")
  label class="flex items-center gap-2 text-sm"
    = f.check_box :active, class: "size-4 accent-emerald-600"
    = t("admin.products.form.active")

  div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end"
    = link_to t("admin.products.form.back"), admin_products_path, class: "btn-secondary"
    = f.submit t("admin.products.form.submit"), class: "btn-primary"
