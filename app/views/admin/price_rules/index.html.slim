- content_for :title, t(".title")

div class="mb-4 flex flex-wrap items-end justify-between gap-4"
  div
    h1 class="text-2xl font-bold sm:text-3xl" = t(".title")
    p class="mt-1 max-w-2xl text-sm text-slate-600" = t(".explanation")
  = link_to t(".new"), new_admin_price_rule_path, class: "btn-primary"

- if @price_rules.any?
  div class="overflow-x-auto rounded-xl bg-white ring-1 ring-slate-200"
    table class="w-full text-left text-sm"
      thead class="bg-slate-50 text-xs text-slate-500 uppercase"
        tr
          th class="px-4 py-2 font-medium" = PriceRule.human_attribute_name(:name)
          th class="px-4 py-2 font-medium" = t(".when")
          th class="px-4 py-2 font-medium" = PriceRule.human_attribute_name(:court)
          th class="px-4 py-2 text-right font-medium" = PriceRule.human_attribute_name(:priority)
          th class="px-4 py-2 text-right font-medium" = PriceRule.human_attribute_name(:price_per_hour_vnd)
          th class="px-4 py-2"
      tbody class="divide-y divide-slate-100"
        - @price_rules.each do |rule|
          tr class=("text-slate-400" unless rule.active)
            td class="px-4 py-2 font-medium"
              = rule.name
              - unless rule.active
                span class="ml-2 text-xs font-normal" = "(#{t(".inactive")})"
            td class="px-4 py-2"
              = "#{format_days(rule.days_of_week)} · #{OpeningHour.format_minute(rule.start_minute)} – #{OpeningHour.format_minute(rule.end_minute)}"
              - if rule.valid_from || rule.valid_until
                p class="text-xs text-slate-500"
                  = [ rule.valid_from && l(rule.valid_from, format: :day_month_year), rule.valid_until && l(rule.valid_until, format: :day_month_year) ].map { |d| d || "…" }.join(" – ")
            td class="px-4 py-2" = rule.court&.name || t(".all_courts")
            td class="px-4 py-2 text-right tabular-nums" = rule.priority
            td class="px-4 py-2 text-right whitespace-nowrap tabular-nums" = format_vnd(rule.price_per_hour_vnd)
            td class="px-4 py-2 text-right whitespace-nowrap"
              = link_to t(".edit"), edit_admin_price_rule_path(rule), class: "link"
- else
  p class="card text-center text-sm text-slate-600" = t(".empty")
