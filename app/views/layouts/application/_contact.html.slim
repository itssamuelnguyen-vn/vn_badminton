/ The "Liên hệ" button of customer pages: plain links to the venue's Zalo, Messenger and phone, as set in
/ Quản lý → Cài đặt (no third-party script). Raised above the booking summary bar while that one shows.
- links = venue&.contact_links || {}
- if links.any?
  details class="group fixed right-4 bottom-4 z-30 [body:has([data-slot-picker-target=summary]:not([hidden]))_&]:bottom-28" data-controller="contact-menu" data-action="click@document->contact-menu#closeOutside keydown.esc@document->contact-menu#close"
    summary class="brand-gradient flex cursor-pointer list-none items-center gap-2 rounded-full px-5 py-3 text-sm font-semibold text-white shadow-xl shadow-emerald-800/30 transition hover:brightness-110 [&::-webkit-details-marker]:hidden"
      svg class="size-5 group-open:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"
        path stroke-linecap="round" stroke-linejoin="round" d="M8 10h8M8 14h5m-9 6 2.5-3H18a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3H6a3 3 0 0 0-3 3v7a3 3 0 0 0 3 3"
      svg class="hidden size-5 group-open:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"
        path stroke-linecap="round" d="M6 6l12 12M18 6 6 18"
      = t(".label")
    div class="absolute right-0 bottom-full mb-3 w-64 space-y-1 rounded-3xl bg-white p-2 shadow-2xl ring-1 ring-ink/5"
      - if (url = links[:zalo])
        = link_to url, target: "_blank", rel: "noopener", class: "flex items-center gap-3 rounded-2xl px-3 py-2.5 text-sm font-semibold hover:bg-slate-50" do
          span class="flex size-8 items-center justify-center rounded-full bg-[#0068ff] text-xs font-bold text-white" aria-hidden="true" Zalo
          = t(".zalo")
      - if (url = links[:messenger])
        = link_to url, target: "_blank", rel: "noopener", class: "flex items-center gap-3 rounded-2xl px-3 py-2.5 text-sm font-semibold hover:bg-slate-50" do
          span class="flex size-8 items-center justify-center rounded-full bg-gradient-to-br from-[#00b2ff] to-[#a033ff] text-white" aria-hidden="true"
            svg class="size-4" viewBox="0 0 24 24" fill="currentColor"
              path d="M12 2C6.36 2 2 6.13 2 11.7c0 2.91 1.19 5.44 3.14 7.17V22l2.86-1.57c1.25.35 2.59.54 4 .54 5.64 0 10-4.13 10-9.7S17.64 2 12 2zm1.04 13.06-2.55-2.72-4.97 2.72 5.47-5.81 2.61 2.72 4.91-2.72-5.47 5.81z"
          = t(".messenger")
      - if (url = links[:phone])
        = link_to url, class: "flex items-center gap-3 rounded-2xl px-3 py-2.5 text-sm font-semibold hover:bg-slate-50" do
          span class="flex size-8 items-center justify-center rounded-full bg-emerald-600 text-white" aria-hidden="true"
            svg class="size-4" viewBox="0 0 24 24" fill="currentColor"
              path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.3 0 .7-.2 1z"
          = t(".phone", phone: PhoneNumber.to_local(venue.phone))
