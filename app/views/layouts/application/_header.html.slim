header class="border-b border-slate-200 bg-white"
  nav class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-3 px-4 py-3 sm:px-6"
    = link_to root_path, class: "flex items-center gap-2 text-lg font-bold text-emerald-700" do
      svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
        path d="M8.5 15.5 4 4l11.5 4.5"
        path d="M6.5 10 14 9.5M9.5 6.5 9 14"
        circle cx="16.5" cy="16.5" r="3.5"
      | VN Badminton

    div class="flex items-center gap-3 text-sm sm:gap-4"
      - if user_signed_in?
        = link_to current_user.full_name, edit_user_registration_path, class: "font-medium text-slate-700 hover:text-emerald-700"
        = button_to t(".sign_out"), destroy_user_session_path, method: :delete, class: "btn-secondary"
      - else
        = link_to t(".sign_in"), new_user_session_path, class: "font-medium text-slate-700 hover:text-emerald-700"
        = link_to t(".sign_up"), new_user_registration_path, class: "btn-primary"

      = render "layouts/application/locale_switcher"
