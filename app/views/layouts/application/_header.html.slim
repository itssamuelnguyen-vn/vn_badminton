/ Desktop: one row. Phones: logo and language switcher on top, the links on a second row.
header class="border-b border-slate-200 bg-white"
  nav class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-4 gap-y-2 px-4 py-3 sm:px-6"
    = link_to root_path, class: "flex items-center gap-2 text-lg font-bold text-emerald-700" do
      svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
        path d="M8.5 15.5 4 4l11.5 4.5"
        path d="M6.5 10 14 9.5M9.5 6.5 9 14"
        circle cx="16.5" cy="16.5" r="3.5"
      | VN Badminton

    div class="sm:order-last"
      = render "layouts/application/locale_switcher"

    / -m-1 p-1: room inside the scroll area for the buttons' rings, which overflow-x-auto would clip.
    div class="-m-1 flex w-full items-center gap-4 overflow-x-auto p-1 text-sm whitespace-nowrap sm:w-auto sm:flex-1 sm:justify-end"
      = link_to t(".schedule"), root_path, class: "font-medium text-slate-700 hover:text-emerald-700"
      - if user_signed_in?
        = link_to t(".my_bookings"), bookings_path, class: "font-medium text-slate-700 hover:text-emerald-700"
        - if current_user.manager?
          = link_to t(".admin"), admin_root_path, class: "font-medium text-slate-700 hover:text-emerald-700"
        / Phones show an account icon instead of the (possibly long) name.
        = link_to edit_user_registration_path, class: "font-medium text-slate-700 hover:text-emerald-700", aria: { label: current_user.full_name } do
          span class="hidden max-w-40 truncate sm:inline" = current_user.full_name
          svg viewBox="0 0 24 24" class="size-6 sm:hidden" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"
            circle cx="12" cy="8" r="4"
            path d="M4 20c1.5-3.5 4.5-5 8-5s6.5 1.5 8 5"
        = button_to t(".sign_out"), destroy_user_session_path, method: :delete, class: "btn-secondary ml-auto px-3 py-1.5 sm:ml-0"
      - else
        = link_to t(".sign_in"), new_user_session_path, class: "ml-auto font-medium text-slate-700 hover:text-emerald-700 sm:ml-0"
        = link_to t(".sign_up"), new_user_registration_path, class: "btn-primary px-3 py-1.5"
