- tabs = [ [ t(".board"), admin_root_path, controller_name.in?(%w[boards bookings]) ],
           [ t(".customers"), admin_customers_path, controller_name == "customers" ] ]
/ Prices, settings and staff are for the owner only.
- if current_user.owner?
  - tabs += [ [ t(".reports"), admin_reports_path, controller_name == "reports" ],
              [ t(".price_rules"), admin_price_rules_path, controller_name == "price_rules" ],
              [ t(".settings"), edit_admin_settings_path, controller_name == "settings" ],
              [ t(".staff"), admin_staff_members_path, controller_name == "staff_members" ] ]

/ The bottom line is an inset shadow, not a border: a -mb-px overlap would overflow and show a vertical scrollbar.
nav class="mb-6 flex gap-1 overflow-x-auto text-sm whitespace-nowrap shadow-[inset_0_-1px_0_var(--color-slate-200)]" aria-label=t(".label")
  - tabs.each do |label, path, current|
    = link_to label, path, aria: { current: ("page" if current) },
        class: [ "border-b-2 px-3 py-2 font-medium", current ? "border-emerald-600 text-emerald-700" : "border-transparent text-slate-600 hover:text-emerald-700" ]
