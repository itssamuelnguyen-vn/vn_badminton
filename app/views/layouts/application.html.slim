doctype html
html lang=I18n.locale class="h-full bg-slate-50"
  head
    title = content_for?(:title) ? "#{yield(:title)} | VN Badminton" : "VN Badminton"
    meta name="viewport" content="width=device-width,initial-scale=1"
    meta name="apple-mobile-web-app-capable" content="yes"
    meta name="application-name" content="VN Badminton"
    meta name="mobile-web-app-capable" content="yes"
    = csrf_meta_tags
    = csp_meta_tag

    = yield :head

    / Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!)
    / = tag.link rel: "manifest", href: pwa_manifest_path(format: :json)

    / The player from the logo (app/assets/images/badminton_logo.jpg) on a transparent background.
    link rel="icon" href="/favicon.ico" sizes="any"
    link rel="icon" href="/icon.png" type="image/png"
    link rel="apple-touch-icon" href="/apple-touch-icon.png"

    / Includes all stylesheet files in app/assets/stylesheets
    = stylesheet_link_tag :app, "data-turbo-track": "reload"
    = javascript_importmap_tags

  / Signed in: the page reloads itself after the session timeout (session_timeout_controller.js).
  body class="flex min-h-full flex-col text-slate-900 antialiased" data-controller=("session-timeout" if user_signed_in?) data-session-timeout-seconds-value=(Devise.timeout_in.to_i if user_signed_in?)
    / Reloads every open page of the account when its deletion is asked, which signs it out (Accounts::Deletion).
    - if user_signed_in?
      = turbo_stream_from current_user, :account
    = render "layouts/application/header"
    = render "layouts/application/unverified_notice"

    main class="mx-auto w-full max-w-5xl flex-1 px-4 py-8 sm:px-6 sm:py-12"
      = render "layouts/application/flash"
      / Nested layouts (layouts/admin) pass their page in :content.
      = content_for?(:content) ? yield(:content) : yield

    - unless controller_path.start_with?("admin/")
      = render "layouts/application/contact", venue: contact_venue

    footer class="border-t border-slate-200 bg-white"
      div class="mx-auto flex max-w-5xl flex-wrap justify-between gap-2 px-4 py-4 text-xs text-slate-500 sm:px-6"
        span = "© #{Date.current.year} VN Badminton"
        = link_to t("layouts.application.footer.privacy"), privacy_path, class: "hover:text-emerald-700"
