- tournament = @tournament

p = t("booking_mailer.confirmed.greeting", name: @entry.user.full_name)

p = t(".intro", title: tournament.display_title, time: l(tournament.starts_at.in_time_zone(tournament.venue.zone), format: :slot))

- if @entry.refund_vnd
  p = t(".refund", amount: format_vnd(@entry.refund_vnd))

p = t("booking_mailer.cancelled.sorry")
- if tournament.venue.phone
  p = t("booking_mailer.cancelled.contact", phone: PhoneNumber.to_local(tournament.venue.phone))
