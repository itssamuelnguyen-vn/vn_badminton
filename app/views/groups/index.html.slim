- content_for :title, t(".title")
- now = Time.current

div class="mx-auto max-w-2xl"
  = link_to t(".back"), bookings_path, class: "link text-sm"
  div class="mt-2 mb-6"
    h1 class="text-2xl font-bold sm:text-3xl" = t(".title")
    p class="mt-2 text-sm text-slate-600" = t(".intro")

  / Create a group, or join one with the code a friend gave.
  div class="mb-10 grid gap-3 sm:grid-cols-2"
    = form_with scope: :group, url: groups_path, class: "surface flex flex-col gap-3 p-4" do |f|
      = f.label :name, t(".create"), class: "form-label mb-0"
      = f.text_field :name, required: true, maxlength: 50, placeholder: t(".name_placeholder"), class: "form-input"
      = f.submit t(".create_submit"), class: "btn-primary"
    = form_with url: join_groups_path, class: "surface flex flex-col gap-3 p-4" do |f|
      = f.label :code, t(".join"), class: "form-label mb-0"
      = f.text_field :code, required: true, maxlength: 6, autocomplete: "off", autocapitalize: "characters", placeholder: "K7Q2M9", class: "form-input font-mono tracking-widest uppercase"
      = f.submit t(".join_submit"), class: "btn-secondary"

  - if @groups.empty?
    div class="card flex flex-col items-center gap-3 text-center"
      span class="flex size-14 items-center justify-center rounded-2xl bg-emerald-50 text-emerald-600" aria-hidden="true"
        svg class="size-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
          circle cx="9" cy="8" r="3.5"
          path d="M2.5 20a6.5 6.5 0 0 1 13 0M16 4.5a3.5 3.5 0 0 1 0 7M18 14.5a6.5 6.5 0 0 1 3.5 5.5"
      p class="text-sm text-slate-600" = t(".none")
  - else
    div class="space-y-6"
      - @groups.each do |group|
        = render "groups/group", group: group, now: now
